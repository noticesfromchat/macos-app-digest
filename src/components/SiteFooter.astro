---
import PhosphorIcon from './PhosphorIcon.astro';

const { current = '' } = Astro.props;
---

<footer id="site-footer" class="site-footer">
  <div class="site-footer-inner page-shell">
    <p>Your weekly guide to Mac apps.</p>
    <nav aria-label="Footer navigation">
      <a href="/explore/" aria-current={current === 'explore' ? 'page' : undefined}>Explore Apps</a>
      <a href="/archive/" aria-current={current === 'archive' ? 'page' : undefined}>Archive</a>
      <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <button
        type="button"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="rss-feed-modal"
        data-rss-open
      >Subscribe</button>
      {/* Beside the X mark on a row, above it once the nav stacks. BaseLayout's theme
          script finds it by data-theme-toggle and keeps the label and glyph current. */}
      <button class="theme-toggle footer-theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
        <PhosphorIcon name="moon" data-theme-moon aria-hidden="true" />
        <PhosphorIcon name="sun" data-theme-sun aria-hidden="true" hidden />
      </button>
      <a
        class="footer-social-link"
        href="https://x.com/macappwaypoint"
        aria-label="App Waypoint on X"
        rel="me noopener noreferrer"
        target="_blank"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.25 6.94 6.06-6.94Zm-1.61 19.49h2.04L6.49 3.24H4.3l12.99 17.4Z" />
        </svg>
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    /* Stepped with the rest of the site's structural vertical spacing. As
       clamp(48px, 6vw, 80px) the gap between the last section and the footer was 60px at
       a 1000px viewport and 76px at 1280, neither of them on the base. */
    margin-top: var(--footer-space);
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .site-footer-inner {
    display: flex;
    min-height: 88px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) 24px;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .site-footer p {
    margin: 0;
    color: var(--muted);
    font-size: var(--type-meta);
  }

  .site-footer nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.8vw, 32px);
    white-space: nowrap;
  }

  /* A nav link is a target, not prose, so it carries one: 24px to clear WCAG 2.2's
     minimum, raised on a coarse pointer below. These were the text line box alone,
     21px tall. */
  .site-footer a,
  .site-footer nav button {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: var(--type-meta);
    font-weight: 600;
    line-height: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible,
  .site-footer a[aria-current='page'],
  .site-footer nav button:hover,
  .site-footer nav button:focus-visible {
    color: var(--accent);
  }

  .site-footer a:focus-visible,
  .site-footer nav button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .footer-social-link {
    width: 24px;
    justify-content: center;
  }

  /* The theme toggle takes the X mark's box: a 24px-wide target at the footer's row
     height. The .theme-toggle base in
     global.css is the header's 40px disc; this outranks it.

     Matched by drawn height, not by box. The X path fills 90.4% of its viewBox, so at
     16px it draws 14.5px; Phosphor's moon fills 79.7% and the sun 93.8%, so at the
     same 16px box the moon drew 12.7px and the sun 15px. Each box is sized so its glyph
     lands at the X's 14.5px: 14.47 / 0.797 and 14.47 / 0.9375. */
  .footer-theme-toggle {
    display: inline-flex;
    width: 24px;
    height: auto;
    justify-content: center;
    color: var(--text);
  }

  /* The moon's path sits high in its viewBox; this lands its top and bottom on the X's. */
  .footer-theme-toggle :global([data-theme-moon]) { --icon-size: 18.17; transform: translateY(.43px); }
  .footer-theme-toggle :global([data-theme-sun]) { --icon-size: 15.43; }

  .footer-social-link svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  @media (pointer: coarse) {
    .site-footer a,
    .site-footer nav button { min-height: 48px; }
  }

  @media (max-width: 680px) {
    .site-footer-inner {
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2) 16px;
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
    }

    /* Stacked, the nav is the Explore menu's single column list and takes its rhythm
       exactly: a 32px row against no gap, so the height of the target is the whole
       interval. It ran 48px rows against an 8px gap, a 56px pitch for a 21px line, which
       made the same list of destinations read at two different tempos depending on which
       page it sat under. 32px clears the 24px floor the Target Floor Rule sets for a
       standalone small target. The 48px lift stays wherever the nav is still a row. */
    .site-footer nav {
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      white-space: normal;
    }

    .site-footer nav a,
    .site-footer nav button { min-height: var(--space-4); }
  }
</style>
