---
import type { CollectionEntry } from 'astro:content';
import MetaIcon from './MetaIcon.astro';
import { getCategoryBySlug } from '../data/categories';

type App = CollectionEntry<'apps'>['data'];
const { app, appId, editorNote, featuredDate, variant = 'default' } = Astro.props as {
  app: App;
  appId?: string;
  editorNote?: string;
  featuredDate?: string;
  variant?: 'default' | 'hero';
};
const isHero = variant === 'hero';
const showEditorsPickIcon = Boolean(
  editorNote && app.collections?.includes('editors-picks')
);
const missingIconColors = ['green', 'orange', 'blue', 'purple', 'pink'] as const;
const colorSeed = appId ?? app.name;
let fallbackColorHash = 0;
for (const char of colorSeed) {
  fallbackColorHash = Math.imul(31, fallbackColorHash) + char.charCodeAt(0);
}
fallbackColorHash ^= fallbackColorHash >>> 16;
fallbackColorHash = Math.imul(fallbackColorHash, 0x7feb352d);
fallbackColorHash ^= fallbackColorHash >>> 15;
fallbackColorHash = Math.imul(fallbackColorHash, 0x846ca68b);
fallbackColorHash ^= fallbackColorHash >>> 16;
const fallbackColor = missingIconColors[
  (fallbackColorHash >>> 0) % missingIconColors.length
];
const fallbackCategory = !app.icon ? getCategoryBySlug(app.categories[0]) : undefined;
const hasIconVisual = Boolean(app.icon || fallbackCategory);
---
<article
  class:list={[
    'card',
    'app-card',
    app.icon ? `app-icon-${app.iconStyle}` : undefined,
    fallbackCategory ? ['app-icon-fallback', `app-icon-color-${fallbackColor}`] : undefined,
    { 'editors-pick-card': editorNote, 'hero-pick-card': isHero }
  ]}
  data-app-name={app.name}
  data-featured-date={featuredDate}
  data-tags={app.tags.join(' ')}
  data-collections={(app.collections ?? []).join(' ')}
>
  {appId && <a class="app-card-link" href={`/apps/${appId}/`} aria-label={`Read more about ${app.name}`}></a>}
  <div class:list={['app-summary', { 'has-app-icon': hasIconVisual }]}>
    <div class="app-summary-heading">
      {app.icon && (
        <div class="app-icon-frame" aria-hidden="true">
          <img class="app-icon" src={app.icon} alt="" loading="lazy" decoding="async" />
        </div>
      )}
      {fallbackCategory && (
        <div class="app-icon-frame missing-app-icon-frame" aria-hidden="true">
          <MetaIcon name={fallbackCategory.icon} />
        </div>
      )}
      <h3 class:list={{ 'editors-pick-title': showEditorsPickIcon }}>
        <a href={app.homepage} target="_blank" rel="noreferrer">{app.name}</a>
        {showEditorsPickIcon && (
          <a
            class="editors-pick-icon-link"
            href="/collections/editors-picks/"
            aria-label="Browse Editor's Picks"
          >
            <svg
              class="editors-pick-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20" />
              <path d="M8.62 9.8A2.25 2.25 0 1 1 12 6.836a2.25 2.25 0 1 1 3.38 2.966l-2.626 2.856a.998.998 0 0 1-1.507 0z" />
            </svg>
          </a>
        )}
      </h3>
    </div>
    <p class="app-description">{app.description}</p>
  </div>
  {isHero ? (
    <>
      {editorNote && (
        <div class="editor-note">
          <p class="editor-note-label">Why it was chosen</p>
          <p>{editorNote}</p>
        </div>
      )}
      <div class="best-for">
        <p class="editor-note-label">Best for</p>
        <p>{app.bestFor}</p>
      </div>
    </>
  ) : (
    <>
      <p class="best-for"><strong>Best for:</strong> {app.bestFor}</p>
      {editorNote && (
        <div class="editor-note">
          <p class="editor-note-label">Why it was chosen</p>
          <p>{editorNote}</p>
        </div>
      )}
    </>
  )}
  <div class="tag-list" aria-label="App tags">
    {app.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}
  </div>
  {!isHero && <p class="source-line"><strong>Source:</strong> {app.source}</p>}
</article>
