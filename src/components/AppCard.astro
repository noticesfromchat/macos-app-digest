---
import type { CollectionEntry } from 'astro:content';
import MetaIcon from './MetaIcon.astro';
import { fallbackIconColor, fallbackIconCategory } from '../data/app-icon';

type App = CollectionEntry<'apps'>['data'];
const { app, appId, editorNote, featuredDate, variant = 'default' } = Astro.props as {
  app: App;
  appId?: string;
  editorNote?: string;
  featuredDate?: string;
  variant?: 'default' | 'hero';
};
const isHero = variant === 'hero';
const fallbackColor = fallbackIconColor(appId ?? app.name);
const fallbackCategory = fallbackIconCategory(app);
const hasIconVisual = Boolean(app.icon || fallbackCategory);
/* The issue's Editor's Pick lights the hero card in its own colour. Only the hero
   pick reads it, and only when the app record carries a reviewed value, so a pick
   with no icon or an undecodable one simply renders the ordinary card. */
const pickAccent = isHero && editorNote ? app.iconAccent : undefined;
const directorySearchText = [
  app.name,
  app.description,
  app.bestFor,
  app.source,
  ...app.tags
].join(' ');
---
<article
  class:list={[
    'card',
    'app-card',
    app.icon ? `app-icon-${app.iconStyle}` : undefined,
    fallbackCategory ? ['app-icon-fallback', `app-icon-color-${fallbackColor}`] : undefined,
    { 'editors-pick-card': editorNote, 'hero-pick-card': isHero, 'has-pick-accent': pickAccent }
  ]}
  style={pickAccent ? `--pick-accent: ${pickAccent};` : undefined}
  data-app-name={app.name}
  data-featured-date={featuredDate}
  data-tags={app.tags.join(' ')}
  data-collections={(app.collections ?? []).join(' ')}
  data-search-text={directorySearchText}
>
  {appId && <a class="app-card-link" href={`/apps/${appId}/`} tabindex="-1" aria-hidden="true"></a>}
  <div class:list={['app-summary', { 'has-app-icon': hasIconVisual }]}>
    <div class="app-summary-heading">
      {app.icon && (
        <div class="app-icon-frame" aria-hidden="true">
          <img class="app-icon" src={app.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />
        </div>
      )}
      {fallbackCategory && (
        <div class="app-icon-frame missing-app-icon-frame" aria-hidden="true">
          <MetaIcon name={fallbackCategory.icon} />
        </div>
      )}
      <h3>
        {appId ? <a href={`/apps/${appId}/`}>{app.name}</a> : app.name}
      </h3>
    </div>
    <p class="app-description">{app.description}</p>
  </div>
  {isHero ? (
    <>
      {editorNote && (
        <div class="editor-note">
          <p class="editor-note-label">Why it was chosen</p>
          <p>{editorNote}</p>
        </div>
      )}
      <div class="best-for">
        <p class="editor-note-label">Best for</p>
        <p>{app.bestFor}</p>
      </div>
    </>
  ) : (
    <>
      <p class="best-for"><strong>Best for:</strong> {app.bestFor}</p>
      {editorNote && (
        <div class="editor-note">
          <p class="editor-note-label">Why it was chosen</p>
          <p>{editorNote}</p>
        </div>
      )}
    </>
  )}
  <div class="tag-list" aria-label="App tags">
    {app.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}
  </div>
</article>
