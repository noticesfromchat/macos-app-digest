---
import PhosphorIcon from './PhosphorIcon.astro';

const { name } = Astro.props as { name: string };

const icons = {
  archive: 'archive',
  camera: 'camera',
  'book-heart': 'star',
  'code-block': 'code-block',
  'code-2': 'code-block',
  files: 'files',
  'flow-arrow': 'flow-arrow',
  'folder-search': 'files',
  gem: 'treasure-chest',
  heart: 'heart',
  'list-checks': 'list-checks',
  notepad: 'notepad',
  'notebook-pen': 'notepad',
  robot: 'robot',
  route: 'list-checks',
  sliders: 'sliders',
  'sliders-horizontal': 'sliders',
  sparkles: 'robot',
  star: 'star',
  'treasure-chest': 'treasure-chest'
} as const;

const icon = icons[name as keyof typeof icons] ?? 'robot';
---

<PhosphorIcon name={icon} />
