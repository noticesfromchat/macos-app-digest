---
import { getCollection, type CollectionEntry } from 'astro:content';
import AppCard from './AppCard.astro';
import { collectionLabels } from '../data/categories';

type FilterType = 'tag' | 'collection';

const {
  apps,
  defaultFilterType,
  defaultFilterValue,
  showFilterMenu = true
} = Astro.props as {
  apps: CollectionEntry<'apps'>[];
  defaultFilterType?: FilterType;
  defaultFilterValue?: string;
  showFilterMenu?: boolean;
};

const [allApps, issues] = await Promise.all([
  getCollection('apps'),
  getCollection('issues')
]);

const featuredDates = new Map<string, string>();

for (const issue of issues) {
  const appIds = [
    ...issue.data.sections.flatMap((section) => section.apps),
    ...(issue.data.editorsPick ? [issue.data.editorsPick.app] : [])
  ];

  for (const appId of appIds) {
    const currentDate = featuredDates.get(appId);
    if (!currentDate || issue.data.slug > currentDate) {
      featuredDates.set(appId, issue.data.slug);
    }
  }
}

const contextualCollectionCount = (collection: string) =>
  apps.filter((entry) => entry.data.collections?.includes(collection)).length;

const contextualTagCount = (tag: string) =>
  apps.filter((entry) => entry.data.tags.includes(tag)).length;

const collectionOptions = [
  ...new Set(allApps.flatMap((entry) => entry.data.collections ?? []))
]
  .sort()
  .map((value) => ({ value, count: contextualCollectionCount(value) }))
  .filter((option) => option.count > 0);

const tagOptions = [
  ...new Set(allApps.flatMap((entry) => entry.data.tags))
]
  .sort()
  .map((value) => ({ value, count: contextualTagCount(value) }))
  .filter((option) => option.count > 0);

/* The directory renders every app so crawlers, the search index and a reader without
   JavaScript all get the whole catalogue, then shows the first batch and reveals the rest
   on request. Explore is the page that needs it: 102 cards in one column ran past 40,000px
   on a phone. The cap is applied in CSS at parse time rather than by the script, so the
   first paint is already short and the page does not collapse from full height once the
   module runs. Keep this in step with the nth-child rule in global.css. */
const DIRECTORY_BATCH = 18;
const sortedApps = [...apps].sort((a, b) =>
  a.data.name.localeCompare(b.data.name, undefined, { sensitivity: 'base' })
);
---
<div
  class="app-directory"
  data-app-directory
  data-default-type={defaultFilterType}
  data-default-value={defaultFilterValue}
>
  {/* The page title is the h1 and every card title is an h3, so without this the
      directory skipped a level. It names the region for a screen reader and keeps
      the outline whole; there is no visible heading here by design. */}
  <h2 class="sr-only">Apps</h2>
  <div class:list={['directory-filter-bar', !showFilterMenu && 'directory-filter-bar--no-filters']}>
    <div class="directory-search">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <label class="sr-only" for={`directory-query-${Astro.url.pathname.replace(/[^a-z0-9]/gi, '-')}`}>
        Search apps
      </label>
      <input
        id={`directory-query-${Astro.url.pathname.replace(/[^a-z0-9]/gi, '-')}`}
        class="directory-query-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search apps"
        maxlength="100"
        disabled
        data-directory-query
      />
    </div>

    {showFilterMenu && (
      <div class="directory-select directory-filter" data-filter-menu>
        <button
          class="directory-select-trigger"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          data-filter-trigger
        >
          <span class="directory-filter-label">
            Filter
            <span class="directory-filter-count" hidden data-filter-count></span>
          </span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div
          class="directory-select-options directory-filter-panel"
          role="group"
          aria-label="Filter apps"
          hidden
          data-filter-panel
        >
          <div class="filter-scroll">
            {collectionOptions.length > 0 && (
              <div class="filter-group" role="group" aria-labelledby="filter-heading-collections">
                <p class="filter-group-label" id="filter-heading-collections">Collections</p>
                {collectionOptions.map(({ value, count }) => (
                  <label class="filter-option">
                    <input
                      type="checkbox"
                      value={value}
                      data-filter-type="collection"
                      checked={defaultFilterType === 'collection' && defaultFilterValue === value}
                      disabled={defaultFilterType === 'collection' && defaultFilterValue === value}
                    />
                    <span class="filter-option-name">{collectionLabels[value] ?? value}</span>
                    <span class="filter-option-count">{count}</span>
                  </label>
                ))}
              </div>
            )}
            <div class="filter-group" role="group" aria-labelledby="filter-heading-tags">
              <p class="filter-group-label" id="filter-heading-tags">Tags</p>
              {tagOptions.map(({ value, count }) => (
                <label class="filter-option">
                  <input
                    type="checkbox"
                    value={value}
                    data-filter-type="tag"
                    checked={defaultFilterType === 'tag' && defaultFilterValue === value}
                    disabled={defaultFilterType === 'tag' && defaultFilterValue === value}
                  />
                  <span class="filter-option-name">{value}</span>
                  <span class="filter-option-count">{count}</span>
                </label>
              ))}
            </div>
          </div>
          <div class="filter-actions">
            <button type="button" class="filter-reset" data-filter-reset>Reset filters</button>
          </div>
        </div>
      </div>
    )}

    <div class="directory-sort">
      <div class="directory-select" data-sort-menu>
        <button
          class="directory-select-trigger"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          data-sort-trigger
        >
          <span>Sort</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div class="directory-select-options" role="menu" aria-label="Sort apps" hidden data-sort-options>
          <button type="button" role="menuitemradio" aria-checked="true" data-sort-value="a-z">A-Z</button>
          <button type="button" role="menuitemradio" aria-checked="false" data-sort-value="z-a">Z-A</button>
          <button type="button" role="menuitemradio" aria-checked="false" data-sort-value="date-featured">Date featured</button>
        </div>
      </div>
    </div>

  </div>
  {/* The count and the chips answer the same question — how many, and why that many — so
      they share a row, and that row sits against the grid it describes rather than at the
      top of the toolbar. In the toolbar the count was a 56px full-width band on a phone,
      three rows above the first card and attached to nothing.

      The chips stay a sibling of the count and never move inside it: .directory-count is
      aria-live, and controls in a live region get re-announced on every result change.

      The list is empty in the markup on purpose. Filtering is script-owned — the query
      input ships disabled — so without JavaScript there is nothing here to remove. The
      script fills it from the same state that drives the count and the URL, which is what
      makes filters restored from ?tags= arrive as chips on load. */}
  <div class="directory-results">
    <p class="directory-count" aria-live="polite" data-directory-count>
      {apps.length} {apps.length === 1 ? 'app' : 'apps'}
    </p>
    <ul class="directory-actives" aria-label="Active filters" hidden data-directory-actives></ul>
  </div>
  <div class="grid directory-grid" data-app-grid data-directory-cap={DIRECTORY_BATCH}>
    {sortedApps.map((entry) => (
      <AppCard
        app={entry.data}
        appId={entry.id}
        featuredDate={featuredDates.get(entry.id) ?? ''}
      />
    ))}
  </div>
  <p class="directory-empty" hidden data-directory-empty>
    <span data-directory-empty-message>No apps match every selected filter</span>
    <button type="button" class="directory-empty-action" hidden data-query-reset>Clear search</button>
  </p>
  <div class="directory-more">
    <button type="button" class="button" hidden data-directory-more></button>
  </div>
  <noscript>
    <style>
      /* Without the script there is no way to reveal the rest, so nothing is hidden.
         `flex` rather than `revert` because that is what .app-card sets on itself. */
      .directory-grid[data-directory-cap] > * { display: flex; }
      .directory-more { display: none; }
    </style>
  </noscript>
</div>

<script>
  type ClientFilterType = 'tag' | 'collection';

  const collator = new Intl.Collator(undefined, {
    numeric: true,
    sensitivity: 'base'
  });
  const allowedSorts = new Set(['a-z', 'z-a', 'date-featured']);

  document.querySelectorAll<HTMLElement>('[data-app-directory]').forEach((directory) => {
    const grid = directory.querySelector<HTMLElement>('[data-app-grid]');
    if (!grid) return;

    const cards = [...grid.querySelectorAll<HTMLElement>('[data-app-name]')];
    const queryInput = directory.querySelector<HTMLInputElement>('[data-directory-query]');
    const directoryCount = directory.querySelector<HTMLElement>('[data-directory-count]');
    const emptyState = directory.querySelector<HTMLElement>('[data-directory-empty]');
    const emptyMessage = directory.querySelector<HTMLElement>('[data-directory-empty-message]');
    const queryReset = directory.querySelector<HTMLButtonElement>('[data-query-reset]');
    const moreButton = directory.querySelector<HTMLButtonElement>('[data-directory-more]');
    const filterMenu = directory.querySelector<HTMLElement>('[data-filter-menu]');
    const filterTrigger = directory.querySelector<HTMLButtonElement>('[data-filter-trigger]');
    const filterPanel = directory.querySelector<HTMLElement>('[data-filter-panel]');
    const filterCount = directory.querySelector<HTMLElement>('[data-filter-count]');
    const activesList = directory.querySelector<HTMLElement>('[data-directory-actives]');
    const sortMenu = directory.querySelector<HTMLElement>('[data-sort-menu]');
    const sortTrigger = directory.querySelector<HTMLButtonElement>('[data-sort-trigger]');
    const sortOptions = directory.querySelector<HTMLElement>('[data-sort-options]');
    const sortButtons = [...directory.querySelectorAll<HTMLButtonElement>('[data-sort-value]')];
    const filters = [
      ...directory.querySelectorAll<HTMLInputElement>('[data-filter-type]')
    ];
    const filterRows = filters
      .map((filter) => filter.closest<HTMLElement>('.filter-option'))
      .filter((row): row is HTMLElement => Boolean(row));
    const filterGroups = filterPanel
      ? [...filterPanel.querySelectorAll<HTMLElement>('.filter-group')]
      : [];
    const defaultType = directory.dataset.defaultType ?? '';
    const defaultValue = directory.dataset.defaultValue ?? '';
    const isDefaultFilter = (filter: HTMLInputElement) =>
      filter.dataset.filterType === defaultType && filter.value === defaultValue;
    const requiredFilter = filters.find((filter) => isDefaultFilter(filter));
    const batchSize = Number(grid.dataset.directoryCap) || 24;
    let visibleLimit = batchSize;
    let selectedSort = 'a-z';

    /* CSS owns the first-paint cap. Once the module runs, `hidden` becomes the single
       visibility mechanism and the query field becomes interactive. */
    grid.removeAttribute('data-directory-cap');
    if (queryInput) queryInput.disabled = false;

    const menus: {
      root: HTMLElement;
      trigger: HTMLButtonElement;
      panel: HTMLElement;
      onOpen?: () => void;
    }[] = [];

    const closeMenu = (
      menu: (typeof menus)[number],
      returnFocus = false
    ) => {
      menu.root.classList.remove('is-open');
      menu.trigger.setAttribute('aria-expanded', 'false');
      menu.panel.hidden = true;
      if (returnFocus) menu.trigger.focus();
    };

    const registerMenu = (
      root: HTMLElement,
      trigger: HTMLButtonElement,
      panel: HTMLElement,
      onOpen?: () => void
    ) => {
      const menu = { root, trigger, panel, onOpen };
      menus.push(menu);

      trigger.addEventListener('click', () => {
        if (root.classList.contains('is-open')) {
          closeMenu(menu);
          return;
        }

        menus.forEach((otherMenu) => {
          if (otherMenu !== menu) closeMenu(otherMenu);
        });
        root.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
        onOpen?.();
      });

      root.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu(menu, true);
      });

      return menu;
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      menus.forEach((menu) => {
        if (!menu.root.contains(target)) closeMenu(menu);
      });
    });

    const values = (card: HTMLElement, key: 'tags' | 'collections') =>
      (card.dataset[key] ?? '').split(' ').filter(Boolean);
    const dedupe = (items: string[]) => [...new Set(items)];
    const queryValue = () => (queryInput?.value ?? '').trim().slice(0, 100);
    const normalizedQuery = () => queryValue().toLowerCase();
    const matchesFilterSet = (
      card: HTMLElement,
      tags: string[],
      collections: string[],
      query: string
    ) => {
      const cardTags = values(card, 'tags');
      const cardCollections = values(card, 'collections');
      const searchText = (card.dataset.searchText ?? '').toLowerCase();

      return (
        tags.every((tag) => cardTags.includes(tag))
        && collections.every((collection) => cardCollections.includes(collection))
        && (!query || searchText.includes(query))
      );
    };
    const countMatchingCards = (tags: string[], collections: string[], query: string) =>
      cards.reduce(
        (count, card) => count + (matchesFilterSet(card, tags, collections, query) ? 1 : 0),
        0
      );

    const selectedFilters = () => filters.filter((filter) => filter.checked);
    const selectedValues = (type: ClientFilterType) => selectedFilters()
      .filter((filter) => filter.dataset.filterType === type)
      .map((filter) => filter.value);

    const syncUrl = () => {
      const url = new URL(window.location.href);
      const query = queryValue();
      const optionalTags = selectedValues('tag').filter((value) =>
        !(defaultType === 'tag' && value === defaultValue)
      );
      const optionalCollections = selectedValues('collection').filter((value) =>
        !(defaultType === 'collection' && value === defaultValue)
      );

      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      optionalTags.length
        ? url.searchParams.set('tags', optionalTags.sort().join(','))
        : url.searchParams.delete('tags');
      optionalCollections.length
        ? url.searchParams.set('collections', optionalCollections.sort().join(','))
        : url.searchParams.delete('collections');
      selectedSort === 'a-z'
        ? url.searchParams.delete('sort')
        : url.searchParams.set('sort', selectedSort);

      window.history.replaceState(window.history.state, '', `${url.pathname}${url.search}${url.hash}`);
    };

    /* Everything the reader added, which is exactly what the badge counts and the URL
       carries. The page's own filter is never in here: on a lane page it is checked and
       disabled, and the h1 directly above already states it. */
    const removableFilters = () =>
      selectedFilters().filter((filter) => !isDefaultFilter(filter));

    /* Built as nodes rather than markup because the query pill's label is whatever the
       reader typed. */
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const svgIcon = (className: string, shapes: [string, Record<string, string>][]) => {
      const svg = document.createElementNS(SVG_NS, 'svg');
      svg.setAttribute('class', className);
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('stroke-width', '2');
      svg.setAttribute('stroke-linecap', 'round');
      svg.setAttribute('stroke-linejoin', 'round');
      for (const [tag, attrs] of shapes) {
        const node = document.createElementNS(SVG_NS, tag);
        for (const [name, value] of Object.entries(attrs)) node.setAttribute(name, value);
        svg.append(node);
      }
      return svg;
    };

    const buildPill = (
      label: string,
      actionLabel: string,
      kind: string,
      value: string,
      leading?: SVGElement
    ) => {
      const item = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'directory-active';
      button.dataset.removeKind = kind;
      button.dataset.removeValue = value;
      /* The visible label is the tag alone, which does not say what pressing it does. */
      button.setAttribute('aria-label', actionLabel);
      button.title = actionLabel;
      if (leading) button.append(leading);
      const text = document.createElement('span');
      text.className = 'directory-active-label';
      text.textContent = label;
      button.append(text, svgIcon('directory-active-x', [
        ['path', { d: 'M18 6 6 18' }],
        ['path', { d: 'm6 6 12 12' }]
      ]));
      item.append(button);
      return item;
    };

    /* Coarsest first: the query, then collections, then tags. */
    const renderActiveFilters = () => {
      if (!activesList) return;
      const removable = removableFilters();
      const rawQuery = queryValue();

      activesList.replaceChildren();

      if (rawQuery) {
        activesList.append(buildPill(
          rawQuery,
          `Clear search: ${rawQuery}`,
          'query',
          '',
          svgIcon('directory-active-glyph', [
            ['circle', { cx: '11', cy: '11', r: '8' }],
            ['path', { d: 'm21 21-4.3-4.3' }]
          ])
        ));
      }

      for (const filter of removable) {
        if (filter.dataset.filterType !== 'collection') continue;
        /* The panel already holds the display label, so a collection reads as
           "Editor's Picks" here rather than as its slug. */
        const name = filter
          .closest('.filter-option')
          ?.querySelector('.filter-option-name')
          ?.textContent?.trim() || filter.value;
        activesList.append(buildPill(name, `Remove filter: ${name}`, 'collection', filter.value));
      }

      for (const filter of removable) {
        if (filter.dataset.filterType !== 'tag') continue;
        activesList.append(buildPill(filter.value, `Remove filter: ${filter.value}`, 'tag', filter.value));
      }

      activesList.hidden = activesList.childElementCount === 0;
    };

    const applyFilters = (updateUrl = true) => {
      if (requiredFilter) requiredFilter.checked = true;
      const selected = selectedFilters();
      const selectedTags = selectedValues('tag');
      const selectedCollections = selectedValues('collection');
      const query = normalizedQuery();
      let matchCount = 0;
      let shownCount = 0;

      /* `cards` is kept in DOM order by the sort, so capping by match position shows the
         first batch of whatever order is currently on screen. */
      cards.forEach((card) => {
        const matches = matchesFilterSet(card, selectedTags, selectedCollections, query);

        if (!matches) {
          card.hidden = true;
          return;
        }

        matchCount += 1;
        const withinLimit = matchCount <= visibleLimit;
        card.hidden = !withinLimit;
        if (withinLimit) shownCount += 1;
      });

      const remaining = matchCount - shownCount;

      if (directoryCount) {
        const noun = matchCount === 1 ? 'app' : 'apps';
        directoryCount.textContent = remaining > 0
          ? `Showing ${shownCount} of ${matchCount} ${noun}`
          : `${matchCount} ${noun}`;
      }
      if (emptyState) {
        emptyState.hidden = matchCount > 0;
        if (matchCount === 0 && emptyMessage) {
          emptyMessage.textContent = query
            ? `No apps match "${queryValue()}"`
            : 'No apps match every selected filter';
        }
        if (queryReset) queryReset.hidden = !query;
      }
      if (moreButton) {
        moreButton.hidden = remaining === 0;
        if (remaining > 0) {
          moreButton.textContent = `Show ${Math.min(batchSize, remaining)} more`;
        }
      }

      if (filterCount) {
        const optionalFilterCount = selected
          .filter((filter) => !isDefaultFilter(filter))
          .length;
        filterCount.textContent = String(optionalFilterCount);
        filterCount.hidden = optionalFilterCount === 0;
        filterMenu?.classList.toggle('has-custom-filters', optionalFilterCount > 0);
      }

      renderActiveFilters();

      filters.forEach((filter, index) => {
        const row = filterRows[index];
        if (!row) return;

        const optionValue = filter.value;
        const candidateTags = filter.dataset.filterType === 'tag'
          ? dedupe([...selectedTags, optionValue])
          : selectedTags;
        const candidateCollections = filter.dataset.filterType === 'collection'
          ? dedupe([...selectedCollections, optionValue])
          : selectedCollections;
        const count = countMatchingCards(candidateTags, candidateCollections, query);
        const countLabel = row.querySelector<HTMLElement>('.filter-option-count');

        if (countLabel) {
          countLabel.textContent = String(count);
        }

        row.hidden = count === 0 && !filter.checked;
      });

      filterGroups.forEach((group) => {
        const hasVisibleOption = [...group.querySelectorAll<HTMLElement>('.filter-option')]
          .some((option) => !option.hidden);
        group.hidden = !hasVisibleOption;
      });

      if (updateUrl) syncUrl();
    };

    const appName = (card: HTMLElement) => card.dataset.appName ?? '';
    const featuredDate = (card: HTMLElement) => card.dataset.featuredDate ?? '';
    const updateSortUi = () => {
      const selectedButton = sortButtons.find((button) => button.dataset.sortValue === selectedSort);
      sortButtons.forEach((button) => {
        button.setAttribute('aria-checked', String(button === selectedButton));
      });
    };
    const sortCards = (updateUrl = true) => {
      cards.sort((a, b) => {
        if (selectedSort === 'z-a') return collator.compare(appName(b), appName(a));
        if (selectedSort === 'date-featured') {
          return (
            featuredDate(b).localeCompare(featuredDate(a))
            || collator.compare(appName(a), appName(b))
          );
        }
        return collator.compare(appName(a), appName(b));
      });
      grid.append(...cards);
      updateSortUi();
      applyFilters(updateUrl);
    };

    const initialUrl = new URL(window.location.href);
    const knownTags = new Set(
      filters.filter((filter) => filter.dataset.filterType === 'tag').map((filter) => filter.value)
    );
    const knownCollections = new Set(
      filters.filter((filter) => filter.dataset.filterType === 'collection').map((filter) => filter.value)
    );
    const urlTags = new Set(
      (initialUrl.searchParams.get('tags') ?? '').split(',').filter((value) => knownTags.has(value))
    );
    const urlCollections = new Set(
      (initialUrl.searchParams.get('collections') ?? '')
        .split(',')
        .filter((value) => knownCollections.has(value))
    );
    const urlSort = initialUrl.searchParams.get('sort') ?? 'a-z';

    if (queryInput) queryInput.value = (initialUrl.searchParams.get('q') ?? '').slice(0, 100);
    selectedSort = allowedSorts.has(urlSort) ? urlSort : 'a-z';
    filters.forEach((filter) => {
      if (isDefaultFilter(filter)) {
        filter.checked = true;
        return;
      }
      filter.checked = filter.dataset.filterType === 'tag'
        ? urlTags.has(filter.value)
        : urlCollections.has(filter.value);
    });

    let filterMenuRegistration: (typeof menus)[number] | undefined;
    if (filterMenu && filterTrigger && filterPanel) {
      filterMenuRegistration = registerMenu(filterMenu, filterTrigger, filterPanel, () => {
        (filters.find((filter) => !filter.disabled) ?? filters[0])?.focus();
      });
    }

    if (sortMenu && sortTrigger && sortOptions) {
      const sortMenuRegistration = registerMenu(sortMenu, sortTrigger, sortOptions, () => {
        sortButtons.find((option) => option.dataset.sortValue === selectedSort)?.focus();
      });

      sortButtons.forEach((option) => {
        option.addEventListener('click', () => {
          const nextSort = option.dataset.sortValue ?? 'a-z';
          selectedSort = allowedSorts.has(nextSort) ? nextSort : 'a-z';
          sortCards();
          closeMenu(sortMenuRegistration, true);
        });
      });
    }

    filters.forEach((filter) => {
      filter.addEventListener('change', () => {
        visibleLimit = batchSize;
        applyFilters();
        if (
          filterMenuRegistration
          && filter.dataset.filterType === 'tag'
          && filter.checked
          && !isDefaultFilter(filter)
        ) {
          closeMenu(filterMenuRegistration, true);
        }
      });
    });

    directory.querySelectorAll<HTMLButtonElement>('[data-filter-reset]').forEach((button) => {
      button.addEventListener('click', () => {
        filters.forEach((filter) => {
          filter.checked = isDefaultFilter(filter);
        });
        visibleLimit = batchSize;
        applyFilters();
      });
    });

    activesList?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement)
        .closest<HTMLButtonElement>('[data-remove-kind]');
      if (!button || !activesList) return;

      const index = [...activesList.querySelectorAll('button')].indexOf(button);

      if (button.dataset.removeKind === 'query') {
        if (queryInput) queryInput.value = '';
      } else {
        const match = filters.find((filter) =>
          filter.dataset.filterType === button.dataset.removeKind
          && filter.value === button.dataset.removeValue
        );
        if (match && !isDefaultFilter(match)) match.checked = false;
      }

      visibleLimit = batchSize;
      applyFilters();

      /* The pill that was focused has just been destroyed. Land on whatever took its
         place, then the last pill, then Clear all, then the control that opens the
         filters. Anything else drops focus to the top of the document. */
      const remaining = [...activesList.querySelectorAll<HTMLButtonElement>('button')];
      const next = remaining[index] ?? remaining[remaining.length - 1];

      if (next) next.focus();
      else if (filterTrigger) filterTrigger.focus();
      else queryInput?.focus();
    });

    queryInput?.addEventListener('input', () => {
      visibleLimit = batchSize;
      applyFilters();
    });
    queryInput?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      queryInput.blur();
    });
    queryReset?.addEventListener('click', () => {
      if (!queryInput) return;
      queryInput.value = '';
      visibleLimit = batchSize;
      applyFilters();
      queryInput.focus();
    });

    moreButton?.addEventListener('click', () => {
      const previouslyVisible = new Set(cards.filter((card) => !card.hidden));
      visibleLimit += batchSize;
      applyFilters();

      /* Focus the card itself, not anything inside it. A card's full-surface link is
         deliberately `tabindex="-1"` and `aria-hidden="true"` for mouse convenience, so
         sending the keyboard there would land it on a node hidden from assistive
         technology, and the only other named link in a card leaves the site. The article
         takes a -1 tabindex so it can receive focus without becoming a tab stop, which
         puts the next Tab inside the newly revealed run.

         Focus never scrolls. The new cards render into the space the button was occupying,
         so the reader is already looking at them; moving the viewport on top of that loses
         their place instead of keeping it. */
      const revealed = cards.find((card) => !card.hidden && !previouslyVisible.has(card));

      if (revealed) {
        revealed.tabIndex = -1;
        revealed.focus({ preventScroll: true });
      }
    });

    sortCards();
  });
</script>
