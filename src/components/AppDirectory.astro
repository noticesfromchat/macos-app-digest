---
import { getCollection, type CollectionEntry } from 'astro:content';
import AppCard from './AppCard.astro';
import { collectionLabels } from '../data/categories';

type FilterType = 'tag' | 'collection';

const {
  apps,
  defaultFilterType,
  defaultFilterValue,
  showFilterMenu = true
} = Astro.props as {
  apps: CollectionEntry<'apps'>[];
  defaultFilterType?: FilterType;
  defaultFilterValue?: string;
  showFilterMenu?: boolean;
};

const [allApps, issues] = await Promise.all([
  getCollection('apps'),
  getCollection('issues')
]);

const featuredDates = new Map<string, string>();

for (const issue of issues) {
  const appIds = [
    ...issue.data.sections.flatMap((section) => section.apps),
    ...(issue.data.editorsPick ? [issue.data.editorsPick.app] : [])
  ];

  for (const appId of appIds) {
    const currentDate = featuredDates.get(appId);
    if (!currentDate || issue.data.slug > currentDate) {
      featuredDates.set(appId, issue.data.slug);
    }
  }
}

const contextualCollectionCount = (collection: string) =>
  apps.filter((entry) => entry.data.collections?.includes(collection)).length;

const contextualTagCount = (tag: string) =>
  apps.filter((entry) => entry.data.tags.includes(tag)).length;

const collectionOptions = [
  ...new Set(allApps.flatMap((entry) => entry.data.collections ?? []))
]
  .sort()
  .map((value) => ({ value, count: contextualCollectionCount(value) }))
  .filter((option) => option.count > 0);

const tagOptions = [
  ...new Set(allApps.flatMap((entry) => entry.data.tags))
]
  .sort()
  .map((value) => ({ value, count: contextualTagCount(value) }))
  .filter((option) => option.count > 0);

/* The directory renders every app so crawlers, the search index and a reader without
   JavaScript all get the whole catalogue, then shows the first batch and reveals the rest
   on request. Explore is the page that needs it: 102 cards in one column ran past 40,000px
   on a phone. The cap is applied in CSS at parse time rather than by the script, so the
   first paint is already short and the page does not collapse from full height once the
   module runs. Keep this in step with the nth-child rule in global.css. */
const DIRECTORY_BATCH = 24;
const sortedApps = [...apps].sort((a, b) =>
  a.data.name.localeCompare(b.data.name, undefined, { sensitivity: 'base' })
);
---
<div
  class="app-directory"
  data-app-directory
  data-default-type={defaultFilterType}
  data-default-value={defaultFilterValue}
>
  {/* The page title is the h1 and every card title is an h3, so without this the
      directory skipped a level. It names the region for a screen reader and keeps
      the outline whole; there is no visible heading here by design. */}
  <h2 class="sr-only">Apps</h2>
  <div class:list={['directory-toolbar', !showFilterMenu && 'directory-toolbar--no-filter']}>
    <p class="directory-count" aria-live="polite" data-directory-count>
      {apps.length} {apps.length === 1 ? 'app' : 'apps'}
    </p>
    <div class="directory-controls">
      {showFilterMenu && (
        <div class="directory-select directory-filter" data-filter-menu>
          <button
            class="directory-select-trigger"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            data-filter-trigger
          >
            <span class="directory-filter-label">
              Filter
              <span class="directory-filter-count" hidden data-filter-count></span>
            </span>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div
            class="directory-select-options directory-filter-panel"
            role="group"
            aria-label="Filter apps"
            hidden
            data-filter-panel
          >
            <p class="filter-note">Show apps matching all selected filters.</p>
            <div class="filter-scroll">
              {collectionOptions.length > 0 && (
                <div class="filter-group" role="group" aria-labelledby="filter-heading-collections">
                  <p class="filter-group-label" id="filter-heading-collections">Collections</p>
                  {collectionOptions.map(({ value, count }) => (
                    <label class="filter-option">
                      <input
                        type="checkbox"
                        value={value}
                        data-filter-type="collection"
                        checked={defaultFilterType === 'collection' && defaultFilterValue === value}
                        disabled={defaultFilterType === 'collection' && defaultFilterValue === value}
                      />
                      <span class="filter-option-name">
                        {collectionLabels[value] ?? value}
                      </span>
                      <span class="filter-option-count">{count}</span>
                    </label>
                  ))}
                </div>
              )}
              <div class="filter-group" role="group" aria-labelledby="filter-heading-tags">
                <p class="filter-group-label" id="filter-heading-tags">Tags</p>
                {tagOptions.map(({ value, count }) => (
                  <label class="filter-option">
                    <input
                      type="checkbox"
                      value={value}
                      data-filter-type="tag"
                      checked={defaultFilterType === 'tag' && defaultFilterValue === value}
                      disabled={defaultFilterType === 'tag' && defaultFilterValue === value}
                    />
                    <span class="filter-option-name">{value}</span>
                    <span class="filter-option-count">{count}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="filter-actions">
              <button type="button" class="filter-reset" data-filter-reset>Reset</button>
            </div>
          </div>
        </div>
      )}
      <div class="directory-sort">
        <div class="directory-select" data-sort-menu>
          <button
            class="directory-select-trigger"
            type="button"
            aria-haspopup="listbox"
            aria-expanded="false"
            data-sort-trigger
          >
            <span data-sort-label>A-Z</span>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div class="directory-select-options" role="listbox" aria-label="Sort apps" hidden data-sort-options>
            <button type="button" role="option" aria-selected="true" data-sort-value="a-z">A-Z</button>
            <button type="button" role="option" aria-selected="false" data-sort-value="z-a">Z-A</button>
            <button type="button" role="option" aria-selected="false" data-sort-value="date-featured">Date featured</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="grid directory-grid" data-app-grid data-directory-cap={DIRECTORY_BATCH}>
    {sortedApps.map((entry) => (
      <AppCard
        app={entry.data}
        appId={entry.id}
        featuredDate={featuredDates.get(entry.id) ?? ''}
      />
    ))}
  </div>
  <p class="directory-empty" hidden data-directory-empty>
    No apps match every selected filter.
    <button type="button" class="filter-reset" data-filter-reset>Reset filters</button>
  </p>
  <div class="directory-more">
    <button type="button" class="button" hidden data-directory-more></button>
  </div>
  <noscript>
    <style>
      /* Without the script there is no way to reveal the rest, so nothing is hidden.
         `flex` rather than `revert` because that is what .app-card sets on itself. */
      .directory-grid[data-directory-cap] > * { display: flex; }
      .directory-more { display: none; }
    </style>
  </noscript>
</div>

<script>
  const collator = new Intl.Collator(undefined, {
    numeric: true,
    sensitivity: 'base'
  });

  document.querySelectorAll<HTMLElement>('[data-app-directory]').forEach((directory) => {
    const grid = directory.querySelector<HTMLElement>('[data-app-grid]');
    if (!grid) return;

    const cards = [...grid.querySelectorAll<HTMLElement>('[data-app-name]')];
    const menus: {
      root: HTMLElement;
      trigger: HTMLButtonElement;
      panel: HTMLElement;
      onOpen?: () => void;
    }[] = [];

    const closeMenu = (
      menu: (typeof menus)[number],
      returnFocus = false
    ) => {
      menu.root.classList.remove('is-open');
      menu.trigger.setAttribute('aria-expanded', 'false');
      menu.panel.hidden = true;
      if (returnFocus) menu.trigger.focus();
    };

    const registerMenu = (
      root: HTMLElement,
      trigger: HTMLButtonElement,
      panel: HTMLElement,
      onOpen?: () => void
    ) => {
      const menu = { root, trigger, panel, onOpen };
      menus.push(menu);

      trigger.addEventListener('click', () => {
        if (root.classList.contains('is-open')) {
          closeMenu(menu);
          return;
        }

        menus.forEach((otherMenu) => {
          if (otherMenu !== menu) closeMenu(otherMenu);
        });
        root.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        panel.hidden = false;
        onOpen?.();
      });

      root.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu(menu, true);
      });

      return menu;
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      menus.forEach((menu) => {
        if (!menu.root.contains(target)) closeMenu(menu);
      });
    });

    const sortMenu = directory.querySelector<HTMLElement>('[data-sort-menu]');
    const sortTrigger = directory.querySelector<HTMLButtonElement>('[data-sort-trigger]');
    const sortLabel = directory.querySelector<HTMLElement>('[data-sort-label]');
    const sortOptions = directory.querySelector<HTMLElement>('[data-sort-options]');
    const sortButtons = [...directory.querySelectorAll<HTMLButtonElement>('[data-sort-value]')];

    if (sortMenu && sortTrigger && sortLabel && sortOptions) {
      let selectedValue = 'a-z';
      const appName = (card: HTMLElement) => card.dataset.appName ?? '';
      const featuredDate = (card: HTMLElement) => card.dataset.featuredDate ?? '';
      const sortCards = (value: string) => {
        cards.sort((a, b) => {
          if (value === 'z-a') {
            return collator.compare(appName(b), appName(a));
          }

          if (value === 'date-featured') {
            return (
              featuredDate(b).localeCompare(featuredDate(a))
              || collator.compare(appName(a), appName(b))
            );
          }

          return collator.compare(appName(a), appName(b));
        });

        grid.append(...cards);
        applyFilters();
      };

      const menu = registerMenu(sortMenu, sortTrigger, sortOptions, () => {
        sortButtons.find((option) => option.dataset.sortValue === selectedValue)?.focus();
      });

      sortButtons.forEach((option) => {
        option.addEventListener('click', () => {
          selectedValue = option.dataset.sortValue ?? 'a-z';
          sortLabel.textContent = option.textContent;
          sortButtons.forEach((button) => {
            button.setAttribute('aria-selected', String(button === option));
          });
          sortCards(selectedValue);
          closeMenu(menu, true);
        });
      });
    }

    const filterMenu = directory.querySelector<HTMLElement>('[data-filter-menu]');
    const filterTrigger = directory.querySelector<HTMLButtonElement>('[data-filter-trigger]');
    const filterPanel = directory.querySelector<HTMLElement>('[data-filter-panel]');
    const filterCount = directory.querySelector<HTMLElement>('[data-filter-count]');
    const directoryCount = directory.querySelector<HTMLElement>('[data-directory-count]');
    const emptyState = directory.querySelector<HTMLElement>('[data-directory-empty]');
    const moreButton = directory.querySelector<HTMLButtonElement>('[data-directory-more]');

    /* CSS held the first paint to one batch. From here the script owns visibility, so the
       attribute comes off and the same cards stay hidden through `hidden` instead. */
    const batchSize = Number(grid.dataset.directoryCap) || 24;
    grid.removeAttribute('data-directory-cap');
    let visibleLimit = batchSize;
    const resetButtons = [...directory.querySelectorAll<HTMLButtonElement>('[data-filter-reset]')];

    if (!filterMenu || !filterTrigger || !filterPanel) return;

    const filters = [
      ...filterPanel.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')
    ];
    const filterRows = filters.map((filter) => filter.closest<HTMLElement>('.filter-option')).filter(Boolean);
    const filterGroups = [...filterPanel.querySelectorAll<HTMLElement>('.filter-group')];
    const defaultType = directory.dataset.defaultType ?? '';
    const defaultValue = directory.dataset.defaultValue ?? '';
    const values = (card: HTMLElement, key: 'tags' | 'collections') =>
      (card.dataset[key] ?? '').split(' ').filter(Boolean);
    const isDefaultFilter = (filter: HTMLInputElement) =>
      filter.dataset.filterType === defaultType && filter.value === defaultValue;
    const requiredFilter = filters.find((filter) => isDefaultFilter(filter));
    const dedupe = (items: string[]) => [...new Set(items)];
    const matchesFilterSet = (card: HTMLElement, tags: string[], collections: string[]) => {
      const cardTags = values(card, 'tags');
      const cardCollections = values(card, 'collections');

      return (
        tags.every((tag) => cardTags.includes(tag))
        && collections.every((collection) => cardCollections.includes(collection))
      );
    };
    const countMatchingCards = (tags: string[], collections: string[]) =>
      cards.reduce((count, card) => count + (matchesFilterSet(card, tags, collections) ? 1 : 0), 0);

    const applyFilters = () => {
      if (requiredFilter) requiredFilter.checked = true;
      const selected = filters.filter((filter) => filter.checked);
      const selectedTags = selected
        .filter((filter) => filter.dataset.filterType === 'tag')
        .map((filter) => filter.value);
      const selectedCollections = selected
        .filter((filter) => filter.dataset.filterType === 'collection')
        .map((filter) => filter.value);
      let matchCount = 0;
      let shownCount = 0;

      /* `cards` is kept in DOM order by the sort, so capping by match position shows the
         first batch of whatever order is currently on screen. */
      cards.forEach((card) => {
        const matches = matchesFilterSet(card, selectedTags, selectedCollections);

        if (!matches) {
          card.hidden = true;
          return;
        }

        matchCount += 1;
        const withinLimit = matchCount <= visibleLimit;
        card.hidden = !withinLimit;
        if (withinLimit) shownCount += 1;
      });

      const remaining = matchCount - shownCount;

      if (directoryCount) {
        const noun = matchCount === 1 ? 'app' : 'apps';
        directoryCount.textContent = remaining > 0
          ? `Showing ${shownCount} of ${matchCount} ${noun}`
          : `${matchCount} ${noun}`;
      }
      if (emptyState) emptyState.hidden = matchCount > 0;
      if (moreButton) {
        moreButton.hidden = remaining === 0;
        if (remaining > 0) {
          moreButton.textContent = `Show ${Math.min(batchSize, remaining)} more`;
        }
      }

      if (filterCount) {
        const isOnlyDefault = selected.length === 1 && isDefaultFilter(selected[0]);
        filterCount.textContent = String(selected.length);
        filterCount.hidden = selected.length === 0 || isOnlyDefault;
        filterMenu.classList.toggle('has-custom-filters', !isOnlyDefault);
      }

      filters.forEach((filter, index) => {
        const row = filterRows[index];
        if (!row) return;

        const optionType = filter.dataset.filterType === 'collection' ? 'collection' : 'tag';
        const optionValue = filter.value;
        const candidateTags = dedupe([
          ...selectedTags,
          ...(optionType === 'tag' ? [optionValue] : [])
        ]);
        const candidateCollections = dedupe([
          ...selectedCollections,
          ...(optionType === 'collection' ? [optionValue] : [])
        ]);
        const count = countMatchingCards(candidateTags, candidateCollections);
        const countLabel = row.querySelector<HTMLElement>('.filter-option-count');

        if (countLabel) {
          countLabel.textContent = String(count);
        }

        row.style.display = count === 0 ? 'none' : '';
      });

      filterGroups.forEach((group) => {
        const hasVisibleOption = [...group.querySelectorAll<HTMLElement>('.filter-option')]
          .some((option) => option.style.display !== 'none');
        group.style.display = hasVisibleOption ? '' : 'none';
      });
    };

    const menu = registerMenu(filterMenu, filterTrigger, filterPanel, () => {
      filters[0]?.focus();
    });

    filters.forEach((filter) => {
      filter.addEventListener('change', () => {
        visibleLimit = batchSize;
        applyFilters();
        if (filter.checked && !isDefaultFilter(filter)) closeMenu(menu, true);
      });
    });

    resetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        filters.forEach((filter) => {
          filter.checked = isDefaultFilter(filter);
        });
        visibleLimit = batchSize;
        applyFilters();
      });
    });

    moreButton?.addEventListener('click', () => {
      const firstNewIndex = cards.filter((card) => !card.hidden).length;
      visibleLimit += batchSize;
      applyFilters();

      /* Focus the card itself, not anything inside it. A card's full-surface link is
         deliberately `tabindex="-1"` and `aria-hidden="true"` for mouse convenience, so
         sending the keyboard there would land it on a node hidden from assistive
         technology, and the only other named link in a card leaves the site. The article
         takes a -1 tabindex so it can receive focus without becoming a tab stop, which
         puts the next Tab inside the newly revealed run.

         Focus never scrolls. The new cards render into the space the button was occupying,
         so the reader is already looking at them; moving the viewport on top of that loses
         their place instead of keeping it. */
      const revealed = cards.filter((card) => !card.hidden)[firstNewIndex];

      if (revealed) {
        revealed.tabIndex = -1;
        revealed.focus({ preventScroll: true });
      }
    });

    applyFilters();
  });
</script>
