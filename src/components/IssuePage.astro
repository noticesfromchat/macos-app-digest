---
/* One template for every issue, newest or oldest: no current or archived state to go
   stale, and the issue's own title as the page heading. The homepage no longer renders
   through this component; it has its own, HomePage.astro. */
import type { CollectionEntry } from 'astro:content';
import Breadcrumb from './Breadcrumb.astro';
import type { Crumb } from '../data/breadcrumb';
import AppCard from './AppCard.astro';
import BrandMark from './BrandMark.astro';
import SubscribeCard from './SubscribeCard.astro';
import ReadingCard from './ReadingCard.astro';
import { issueLabel } from '../data/issue';
import WaveRule from './WaveRule.astro';
import { siteCopy } from '../data/site-copy';

type Issue = CollectionEntry<'issues'>['data'];
type AppEntry = CollectionEntry<'apps'>;

const {
  trail = [],
  issue,
  appEntries
} = Astro.props as {
  trail?: Crumb[];
  issue: Issue;
  appEntries: AppEntry[];
};

const appsById = new Map(appEntries.map((entry) => [entry.id, entry]));
/* Every app section gets an anchor from its own label, so any section can be linked to.
   The first keeps the id it has always had. */
const sectionId = (eyebrow: string, index: number) => index === 0
  ? 'new-discoveries'
  : eyebrow.toLowerCase().replace(/&/g, ' ').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const label = issueLabel(issue.number);
const editorsPick = issue.editorsPick ? appsById.get(issue.editorsPick.app) : undefined;
const videoCta = issue.video.url.includes('developer.apple.com/videos')
  ? 'Watch on Apple Developer'
  : issue.video.url.includes('youtube.com') || issue.video.url.includes('youtu.be')
    ? 'Watch on YouTube'
    : 'Watch video';
---

<article class="issue">
  <header class="home-hero">
    <canvas class="home-hero-sky" aria-hidden="true"></canvas>
    <canvas class="home-hero-sea" aria-hidden="true"></canvas>

    {/* The trail sits inside the hero rather than above it. Above it, it pushed the hero
        down the page and exposed the page ground as a band between the header and the
        hero's darker opening. Inside, it stands on the ground the hero already paints and
        costs the hero no vertical position. */}
    <div class="page-shell issue-breadcrumb-shell">
      <Breadcrumb trail={trail} />
    </div>

    <div class="home-hero-inner">
    {/* One template for every issue. The label is the issue's number, which never goes
        stale; the heading is its title, the same words as the browser title. */}
    <div class="home-hero-copy issue-hero-copy">
      {/* The publication's own intro, as on the live issue page. The wordmark is not the
          heading here: the issue's title is. */}
      <div class="home-hero-intro">
        <p class="home-hero-wordmark">App Waypoint</p>
        <WaveRule />
        <p class="home-hero-tagline">
          {siteCopy['issue.heroLine1']}<br />{siteCopy['issue.heroLine2']}
        </p>
      </div>

      <div class="home-hero-issue">
        <p class="eyebrow">{siteCopy['issue.label']}</p>
        <h1 class="home-hero-number">{issue.rss.title}</h1>
        <p class="home-hero-date">
          Issue {label} · Published <time datetime={issue.slug}>{issue.date}</time>
        </p>
        <p class="home-hero-dek">{issue.dek}</p>
      </div>
    </div>

    {editorsPick && (
      <div class="home-hero-pick" id="editors-pick">
        <h2 class="home-hero-pick-title">Editor’s Pick</h2>
        <AppCard
          app={editorsPick.data}
          appId={editorsPick.id}
          editorNote={issue.editorsPick?.reason}
          variant="hero"
          showTags={false}
        />
      </div>
    )}
    </div>
  </header>
  {issue.sections.map((section, index) => (
    <>
      <section id={sectionId(section.eyebrow, index)} class:list={['section', 'issue-section', { 'issue-section-first': index === 0 }]}>
        <div class="section-heading">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.title}</h2>
        </div>
        <div class="grid">
          {section.apps.map((appId) => {
            const app = appsById.get(appId);
            return app ? <AppCard app={app.data} appId={app.id} /> : null;
          })}
        </div>
      </section>
    </>
  ))}

  {/* A waypoint between the apps and the watching and reading. The mark is
      always drawn; its light fires once when the divider first comes into view. */}
  <div class="content-divider" aria-hidden="true" data-waypoint>
    <canvas class="content-divider-sea"></canvas>
    <BrandMark class="content-divider-mark" ping={true} />
  </div>

  <section class="section video-section">
    <div class="section-heading">
      <h2 class="section-title">Video of the Week</h2>
    </div>
    {/* The supplied title sits inside the card at Card Title rank rather than heading the
        section. At Section Title scale a promotional listicle headline read at the same
        rank, and in the same editorial serif, as the publication's own section titles.
        Card Title is still serif; what changes is rank and placement, so the title stays
        attributed and stays a heading. Third-party titles are not barred from being
        headings: ReadingCard renders each Weekend Reading title as its own h3 the same
        way. What is barred is one of them opening a section in the publication's voice. */}
    <article class="card feature-card">
      <h3 class="feature-card-title">{issue.video.title}</h3>
      <p><strong>Creator:</strong> {issue.video.creator}</p>
      <p>{issue.video.description}</p>
      <a href={issue.video.url} target="_blank" rel="noreferrer">{videoCta}</a>
    </article>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2 class="section-title">Weekend Reading</h2>
    </div>
    <div class="grid">
      {issue.readings.map((reading) => <ReadingCard reading={reading} />)}
    </div>
  </section>

  <section class="section issue-subscribe">
    <SubscribeCard />
  </section>
</article>

<style>
  /* The copy column spreads the intro and the issue block apart to meet the pick card, so
     the interval is whatever is left; its floor is a grid step rather than the live hero's
     fluid clamp. The inner grid has one row, so its row gap does nothing and is zeroed. */
  .home-hero-inner { row-gap: 0; }
  .issue-hero-copy { gap: var(--space-4); }
  /* The same block as the homepage's current issue: label, title at Subhead, then
     "Issue NN · Published", then the summary. The title keeps its h1 rank but not the
     Page Title size. */
  .issue-hero-copy h1.home-hero-number {
    font-size: var(--type-subhead);
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.1;
  }
  /* The pick card says what the app is, why it was chosen and who it suits; its tags stay
     on the app's own page and are not rendered here. */
  /* Stacked, the pick follows the issue text instead of sitting beside it, so it drops Best
     for and keeps to what the app is and why it was chosen. */
  @media (max-width: 920px) {
    .home-hero-pick :global(.hero-pick-card .best-for) { display: none; }
    /* Stacked, the pick closes the hero, and the hero's 64px close plus the first section's
       24px open made 88px where every other section break is 48. Pull the first section up
       by the difference, and above the hero's closing fade so its heading is not dimmed. */
    .issue-section-first {
      position: relative;
      z-index: 1;
      margin-top: calc(var(--space-3) - var(--space-8));
    }
  }

  /* A jumped-to section clears the sticky header rather than sliding under it. */
  .issue-section { scroll-margin-top: 80px; }
  @media (max-width: 680px) {
    .issue-section { scroll-margin-top: 72px; }
  }

</style>

<script>
  /* The same sky and sea as the homepage, from one shared file. */
  import { initHeroAtmosphere } from '../scripts/hero-atmosphere';
  initHeroAtmosphere();
</script>
