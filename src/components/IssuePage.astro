---
import type { CollectionEntry } from 'astro:content';
import AppCard from './AppCard.astro';
import ReadingCard from './ReadingCard.astro';

type Issue = CollectionEntry<'issues'>['data'];
type AppEntry = CollectionEntry<'apps'>;

const {
  homepage = false,
  homepageStyle = homepage,
  issue,
  appEntries
} = Astro.props as {
  homepage?: boolean;
  homepageStyle?: boolean;
  issue: Issue;
  appEntries: AppEntry[];
};

const appsById = new Map(appEntries.map((entry) => [entry.id, entry]));
const issueLabel = String(Number(issue.number)).padStart(2, '0');
const aiSectionIndex = issue.sections.findIndex((section) => section.eyebrow.toLowerCase() === 'ai & automation');
const trendingSectionIndex = issue.sections.findIndex((section) => section.eyebrow.toLowerCase() === 'trending');
const editorsPickIndex = aiSectionIndex >= 0
  ? aiSectionIndex
  : trendingSectionIndex >= 0
    ? trendingSectionIndex + 1
    : issue.sections.length;
const editorsPick = issue.editorsPick ? appsById.get(issue.editorsPick.app) : undefined;
---

<article class:list={['issue', { 'is-homepage': homepageStyle }]}>
  <header class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        {homepage
          ? 'Curated Mac Apps for Experienced Users · Published Fridays'
          : 'App Waypoint Issue'}
      </p>
      <h1><time datetime={issue.slug}>{issue.date}</time></h1>
      <p class="date">{homepage ? `Current Issue · Issue ${issueLabel}` : `Issue ${issueLabel}`}</p>
      <div class="hero-rule" aria-hidden="true">
        <svg viewBox="0 0 104 14" role="presentation">
          <path d="M1 7c8-6 16 6 24 0s16 6 24 0 16 6 24 0 16 6 24 0" />
        </svg>
      </div>
      <p class="dek">{issue.dek}</p>
      <div class="hero-actions">
        <a class="button" href="#new-discoveries">Start Reading <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="harbor-artwork" aria-hidden="true">
      <img class="harbor-artwork-light" src="/harbor-hero-clean.webp" alt="" width="1200" height="800" />
      <img class="harbor-artwork-dark" src="/harbor-hero-dark-clean-stars.webp" alt="" width="1200" height="800" />
    </div>
  </header>

  {issue.sections.map((section, index) => (
    <>
      {editorsPick && index === editorsPickIndex && (
        <section id="editors-pick" class="section editors-pick-section">
          <div class="section-heading editors-pick-heading">
            <p class="eyebrow">Editor's Pick</p>
            <h2>One app worth a closer look</h2>
          </div>
          <div class="editors-pick-grid">
            <AppCard app={editorsPick.data} appId={editorsPick.id} editorNote={issue.editorsPick?.reason} />
          </div>
        </section>
      )}
      <section id={index === 0 ? 'new-discoveries' : undefined} class="section">
        <div class="section-heading">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.title}</h2>
        </div>
        <div class="grid">
          {section.apps.map((appId) => {
            const app = appsById.get(appId);
            return app ? <AppCard app={app.data} appId={app.id} /> : null;
          })}
        </div>
      </section>
    </>
  ))}

  {editorsPick && editorsPickIndex === issue.sections.length && (
    <section id="editors-pick" class="section editors-pick-section">
      <div class="section-heading editors-pick-heading">
        <p class="eyebrow">Editor's Pick</p>
        <h2>One app worth a closer look</h2>
      </div>
      <div class="editors-pick-grid">
        <AppCard app={editorsPick.data} appId={editorsPick.id} editorNote={issue.editorsPick?.reason} />
      </div>
    </section>
  )}

  <div class="content-divider" aria-hidden="true">
    <svg viewBox="0 0 1200 128" role="presentation">
      <path class="divider-route" pathLength="100" d="M-28 68C95 68 120 33 220 44c91 10 33 76 112 73 61-2 11-88 91-89 74-1 66 72 143 65 80-8 34-66 119-70 81-4 58 83 151 78 89-5 70-67 154-62 74 5 83 43 161 39" />
      <g class="divider-sailboat" transform="translate(1136 31) scale(2)">
        <path d="M10 2v15" />
        <path d="M7 22a4 4 0 0 1-4-4 1 1 0 0 1 1-1h16a1 1 0 0 1 1 1 4 4 0 0 1-4 4z" />
        <path d="M9.159 2.46a1 1 0 0 1 1.521-.193l9.977 8.98A1 1 0 0 1 20 13H4a1 1 0 0 1-.824-1.567z" />
      </g>
    </svg>
  </div>

  <section class="section video-section">
    <div class="section-heading">
      <p class="eyebrow">Video of the Week</p>
      <h2>{issue.video.title}</h2>
    </div>
    <article class="card feature-card">
      <p><strong>Creator:</strong> {issue.video.creator}</p>
      <p>{issue.video.description}</p>
      <a href={issue.video.url} target="_blank" rel="noreferrer">Watch on YouTube</a>
    </article>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Weekend Reading</p>
      <h2>Three reads for Mac context</h2>
    </div>
    <div class="grid">
      {issue.readings.map((reading) => <ReadingCard reading={reading} />)}
    </div>
  </section>

  <section class="note">
    <h2>Source Notes</h2>
    <p>This issue was selected from the following sources, with every app homepage checked before publishing.</p>
    <ul>
      {issue.sourceNotes.map((note) => <li>{note}</li>)}
    </ul>
  </section>
</article>
