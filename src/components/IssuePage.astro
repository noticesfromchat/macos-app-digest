---
import type { CollectionEntry } from 'astro:content';
import AppCard from './AppCard.astro';
import BrandMark from './BrandMark.astro';
import WaveRule from './WaveRule.astro';
import ReadingCard from './ReadingCard.astro';

type Issue = CollectionEntry<'issues'>['data'];
type AppEntry = CollectionEntry<'apps'>;

const {
  homepage = false,
  issue,
  appEntries
} = Astro.props as {
  homepage?: boolean;
  issue: Issue;
  appEntries: AppEntry[];
};

const appsById = new Map(appEntries.map((entry) => [entry.id, entry]));
const issueLabel = String(Number(issue.number)).padStart(2, '0');
const editorsPick = issue.editorsPick ? appsById.get(issue.editorsPick.app) : undefined;
const Wordmark = homepage ? 'h1' : 'p';
const IssueHeading = homepage ? 'p' : 'h1';
---

<article class="issue">
  <header class="home-hero">
    <canvas class="home-hero-sky" aria-hidden="true"></canvas>
    <canvas class="home-hero-sea" aria-hidden="true"></canvas>

    <div class="home-hero-inner">
    <div class="home-hero-copy">
      <div class="home-hero-intro">
        <Wordmark class="home-hero-wordmark">App Waypoint</Wordmark>
        <WaveRule />
        <p class="home-hero-tagline">
          Your weekly guide to Mac apps.<br />New issues published every Friday.
        </p>
      </div>

      <div class="home-hero-issue">
        <p class="eyebrow">{homepage ? 'Current issue' : 'Archived issue'}</p>
        <IssueHeading class="home-hero-number">Issue {issueLabel}</IssueHeading>
        <p class="home-hero-date">
          Published <time datetime={issue.slug}>{issue.date}</time>
        </p>
        <p class="home-hero-dek">{issue.dek}</p>
      </div>
    </div>

    {editorsPick && (
      <div class="home-hero-pick" id="editors-pick">
        <p class="eyebrow">{homepage ? 'This Week’s Editor’s Pick' : 'Editor’s Pick'}</p>
        <h2 class="home-hero-pick-title">One app worth a closer look</h2>
        <AppCard
          app={editorsPick.data}
          appId={editorsPick.id}
          editorNote={issue.editorsPick?.reason}
          variant="hero"
        />
      </div>
    )}
    </div>
  </header>
  {issue.sections.map((section, index) => (
    <>
      <section id={index === 0 ? 'new-discoveries' : undefined} class="section">
        <div class="section-heading">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.title}</h2>
        </div>
        <div class="grid">
          {section.apps.map((appId) => {
            const app = appsById.get(appId);
            return app ? <AppCard app={app.data} appId={app.id} /> : null;
          })}
        </div>
      </section>
    </>
  ))}

  {/* A waypoint between the apps and the watching and reading. The mark is
      always drawn; its light fires once when the divider first comes into view. */}
  <div class="content-divider" aria-hidden="true" data-waypoint>
    <canvas class="content-divider-sea"></canvas>
    <BrandMark class="content-divider-mark" ping={true} />
  </div>

  <section class="section video-section">
    <div class="section-heading">
      <p class="eyebrow">Video of the Week</p>
      <h2>{issue.video.title}</h2>
    </div>
    <article class="card feature-card">
      <p><strong>Creator:</strong> {issue.video.creator}</p>
      <p>{issue.video.description}</p>
      <a href={issue.video.url} target="_blank" rel="noreferrer">Watch on YouTube</a>
    </article>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Weekend Reading</p>
      <h2>Three reads for Mac context</h2>
    </div>
    <div class="grid">
      {issue.readings.map((reading) => <ReadingCard reading={reading} />)}
    </div>
  </section>

  <section class="note">
    <h2>Source Notes</h2>
    <p>This issue was selected from the following sources, with every app homepage checked before publishing.</p>
    <ul class="source-timeline" data-source-timeline>
      {issue.sourceNotes.map((note, index) => (
        <li style={`--source-index: ${index};`}>
          <span class="source-timeline-marker" aria-hidden="true"></span>
          <span class="source-timeline-copy">{note}</span>
        </li>
      ))}
    </ul>
  </section>
</article>

<script>
  /* Hero atmosphere: a star field for the night theme and an engraved wave
     band for both. Drawn rather than loaded, so it costs no image request.
     Static — painted once, then only on theme change or meaningful resize. */

  /* A buoy is identified by the rhythm of its light. This one flashes once, as
     you pass it, once it reaches the middle of the screen rather than its edge.
     One shot per load: the observer releases the element after. */
  const waypoint = document.querySelector('[data-waypoint]');
  const stillness = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (waypoint && !stillness.matches && 'IntersectionObserver' in window) {
    const passing = new IntersectionObserver((entries, observer) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-lit');
        observer.unobserve(entry.target);
      }
    }, { rootMargin: '-35% 0px -35% 0px', threshold: 0 });
    passing.observe(waypoint);
  }

  const sourceTimeline = document.querySelector('[data-source-timeline]');

  if (sourceTimeline && !stillness.matches && 'IntersectionObserver' in window) {
    sourceTimeline.classList.add('is-motion-ready');
    const sourcePassing = new IntersectionObserver((entries, observer) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    }, { rootMargin: '-18% 0px -12% 0px', threshold: 0.12 });
    sourcePassing.observe(sourceTimeline);
  }

  const sky = document.querySelector('.home-hero-sky');
  const sea = document.querySelector('.home-hero-sea');
  const dividerSea = document.querySelector('.content-divider-sea');

  if (sky || sea || dividerSea) {
    const root = document.documentElement;
    const token = (name) => getComputedStyle(root).getPropertyValue(name).trim();
    const isDark = () => root.dataset.theme === 'dark';

    const fit = (canvas) => {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return null;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      const ctx = canvas.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, rect.width, rect.height);
      return { ctx, w: rect.width, h: rect.height };
    };

    const signature = () => [sky, sea, dividerSea]
      .filter(Boolean)
      .map((canvas) => {
        const rect = canvas.getBoundingClientRect();
        return `${Math.round(rect.width)}x${Math.round(rect.height)}`;
      })
      .join('|');

    const seededUnit = (seed) => {
      const value = Math.sin(seed * 127.1 + 311.7) * 43758.5453123;
      return value - Math.floor(value);
    };

    /* Stars belong to night only; by day the wave band carries the hero alone. */
    const drawSky = () => {
      if (!sky) return;
      const c = fit(sky);
      if (!c || !isDark()) return;
      const ink = token('--sea-ink');
      const count = Math.floor((c.w * c.h) / 5200);
      for (let i = 0; i < count; i += 1) {
        const x = seededUnit(i + 1) * c.w;
        const y = seededUnit(i + 101) * c.h * 0.82;
        const r = seededUnit(i + 201) * 1.3 + 0.2;
        const a = seededUnit(i + 301) * 0.5 + 0.12;
        c.ctx.beginPath();
        c.ctx.arc(x, y, r, 0, Math.PI * 2);
        c.ctx.fillStyle = `rgb(${ink} / ${a})`;
        c.ctx.fill();
      }
    };

    /* Layered sine lines: amplitude decays with depth, wavelength grows, and a
       second harmonic keeps the crests from repeating mechanically. The hero
       runs it full strength; the divider runs the same water, quieted and
       dissolved at both ends so it reads as a passage rather than a rule. */
    const drawWaves = (canvas, { lines, amp, quiet = 1, fadeEnds = false }) => {
      if (!canvas) return;
      const c = fit(canvas);
      if (!c) return;
      const ink = token('--sea-ink');
      const peak = (parseFloat(token('--sea-alpha')) || 0.3) * quiet;
      for (let l = 0; l < lines; l += 1) {
        const t = lines === 1 ? 0 : l / (lines - 1);
        const baseY = c.h * (0.24 + t * 0.7);
        const a = amp * (1 - t * 0.45) + 2;
        const wl = 60 + l * 14;
        const phase = l * 0.9;
        c.ctx.beginPath();
        for (let x = 0; x <= c.w; x += 4) {
          const y = baseY
            + Math.sin(x / wl + phase) * a
            + Math.sin(x / (wl * 2.3) + phase * 1.7) * a * 0.4;
          if (x === 0) c.ctx.moveTo(x, y); else c.ctx.lineTo(x, y);
        }
        const alpha = peak * Math.pow(1 - t, 1.35);
        if (fadeEnds) {
          const grad = c.ctx.createLinearGradient(0, 0, c.w, 0);
          grad.addColorStop(0, `rgb(${ink} / 0)`);
          grad.addColorStop(0.28, `rgb(${ink} / ${alpha})`);
          grad.addColorStop(0.72, `rgb(${ink} / ${alpha})`);
          grad.addColorStop(1, `rgb(${ink} / 0)`);
          c.ctx.strokeStyle = grad;
        } else {
          c.ctx.strokeStyle = `rgb(${ink} / ${alpha})`;
        }
        c.ctx.lineWidth = 1.1;
        c.ctx.stroke();
      }
    };

    let lastPaintSignature = '';
    const paint = ({ force = false } = {}) => {
      const nextSignature = signature();
      if (!force && nextSignature === lastPaintSignature) return;
      lastPaintSignature = nextSignature;
      drawSky();
      drawWaves(sea, { lines: 8, amp: 13 });
      drawWaves(dividerSea, { lines: 5, amp: 7, quiet: 0.7, fadeEnds: true });
    };

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(paint, 150);
    });
    document.addEventListener('appwaypoint:themechange', () => paint({ force: true }));

    paint({ force: true });
    if (document.readyState !== 'complete') window.addEventListener('load', () => paint({ force: true }));
  }
</script>
