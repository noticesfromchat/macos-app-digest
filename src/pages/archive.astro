---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const issues = [...await getCollection('issues')].sort((a, b) => b.data.slug.localeCompare(a.data.slug));
const issueLabel = (number: string | number) => String(Number(number)).padStart(2, '0');
---
<BaseLayout
  title="Weekly Mac App Digest Archive — App Waypoint"
  description="Browse every issue of App Waypoint, a weekly editorial guide to thoughtfully selected Mac apps, automation tools, AI software and Mac-focused reading."
  current="archive"
>
  <section class="page-shell archive-page">
    <p class="eyebrow">All Issues</p>
    <h1>App Waypoint Archive</h1>
    <p class="dek">Browse every published issue of App Waypoint.</p>
    <a class="button archive-current-link" href="/">Current Issue <span aria-hidden="true">→</span></a>

    <div class="archive-list">
      {issues.map((issue) => (
        <a class="archive-card" href={`/issues/${issue.data.slug}/`}>
          <strong>Issue {issueLabel(issue.data.number)}</strong>
          <span class="archive-card-date"><time datetime={issue.data.slug}>{issue.data.date}</time></span>
          <em>{issue.data.dek}</em>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
