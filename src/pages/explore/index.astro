---
import { getCollection } from 'astro:content';
import { OG_SIZE, ogPath } from '../../data/og';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { topLevelTrail, itemListSchema } from '../../data/breadcrumb';
import AppDirectory from '../../components/AppDirectory.astro';
import MetaIcon from '../../components/MetaIcon.astro';
import {
  categories,
  collectionLabels,
  collections,
  getPopularTags
} from '../../data/categories';

/* Two things, in this order: the taxonomy, then the catalogue itself.
   The page used to run to eight screens by sampling three apps from each of eight
   shelves and closing on a carousel that surfaced one app per gesture, which meant the
   browse index never actually contained the thing it indexed: every child page carried
   a count, a filter and a sort that its own parent did not. `AppDirectory` is the same
   component the tag, collection and category pages already use, so Explore now has at
   least as much power as anything below it.

   Deleting the shelves took the client renderer with them, and with it a second random
   selection that overwrote the server's on every load, and a hand-copied card template
   that had already drifted from `AppCard.astro`. */
const apps = await getCollection('apps');
const sortedCategories = [...categories].sort((a, b) =>
  a.title.localeCompare(b.title, undefined, { sensitivity: 'base' })
);
const popularTags = getPopularTags(apps.map((entry) => entry.data));

/* An app carries several categories, so these do not partition the catalogue and will
   not sum to its size. They answer "how much is behind this door", which is what a
   reader picking a lane is asking, and the tag chips beside them have carried the same
   kind of number all along. */
const categoryCounts = new Map(
  categories.map((category) => [
    category.slug,
    apps.filter((entry) => entry.data.categories.includes(category.slug)).length
  ])
);
const collectionCounts = new Map(
  collections.map((collection) => [
    collection.slug,
    apps.filter((entry) => entry.data.collections?.includes(collection.slug)).length
  ])
);
const collectionDescriptions: Record<string, string> = {
  'editors-picks': 'Editor-selected standouts with distinctive utility, polish or an especially memorable point of view.',
  'community-favorites': 'Apps Mac readers keep recommending for dependable workflows, practical value and repeat use.'
};

const trail = topLevelTrail('Explore');

const listSchema = itemListSchema(apps.map((entry) => ({ name: entry.data.name, href: `/apps/${entry.id}/` })), Astro.site);
---
<BaseLayout
  structuredData={[listSchema]}
  breadcrumb={trail}
  title="Explore Mac Apps — App Waypoint"
  socialImage={ogPath('explore')}
  socialImageSize={OG_SIZE}
  socialImageAlt="Explore every Mac app App Waypoint has recommended, by category, collection or tag."
  description="Browse every Mac app App Waypoint has recommended, by category, collection or tag, with the full catalog filterable and sortable on one page."
  current="explore"
>
  <section class="page-shell archive-page explore-page">
    <Breadcrumb trail={trail} />
    <header class="explore-hero">
      <h1>Explore Apps</h1>
      <p class="dek">
        Hand-picked Mac apps from every issue, browsable by category, collection or tag.
        Apps selected and added every Friday.
      </p>
    </header>

    <section class="section explore-section explore-discovery-section">
      <article class="card explore-utility-card explore-utility-combined-card explore-discovery-card">
        <div class="explore-discovery-layout">
          <section class="explore-discovery-categories">
            <div class="section-heading explore-panel-heading">
              <h2>Categories</h2>
              <p class="taxonomy-help-copy">Broad workflow areas that group related apps. An app can appear in more than one.</p>
            </div>
            <div class="explore-collection-list explore-category-list" aria-label="App Waypoint categories">
              {sortedCategories.map((category) => (
                <a
                  class="explore-discovery-link explore-category-link"
                  href={`/categories/${category.slug}/`}
                >
                  <span class="explore-discovery-icon" aria-hidden="true">
                    <MetaIcon name={category.icon} />
                  </span>
                  <span>
                    <strong>
                      {category.title}
                      <span class="explore-discovery-count">({categoryCounts.get(category.slug)})</span>
                    </strong>
                    <small class="explore-category-description explore-category-description-desktop">
                      {category.description}
                    </small>
                    <small class="explore-category-description explore-category-description-mobile">
                      {category.mobileDescription}
                    </small>
                  </span>
                </a>
              ))}
            </div>
          </section>

          <div class="explore-utility-grid explore-discovery-lower-grid">
            <section class="explore-discovery-collections">
              <div class="section-heading explore-panel-heading">
                <h2>Collections</h2>
                <p class="taxonomy-help-copy">Apps grouped by editorial judgment from the editor and community.</p>
              </div>
              <div class="explore-collection-list">
                {collections.map((collection) => (
                  <a class="explore-discovery-link" href={`/collections/${collection.slug}/`}>
                    <span class="explore-discovery-icon" aria-hidden="true">
                      <MetaIcon name={collection.icon} />
                    </span>
                    <span>
                      <strong>
                        {collectionLabels[collection.slug]}
                        <span class="explore-discovery-count">({collectionCounts.get(collection.slug)})</span>
                      </strong>
                      <small>{collectionDescriptions[collection.slug]}</small>
                    </span>
                  </a>
                ))}
              </div>
            </section>

            <section class="explore-utility-tags-panel">
              <div class="section-heading explore-panel-heading">
                <h2>Popular tags</h2>
                <p class="taxonomy-help-copy">Specific features and capabilities for narrowing the catalog.</p>
              </div>
              <div class="tag-list explore-popular-tags" aria-label="Popular tags">
                {popularTags.map(({ tag, count }) => (
                  <a class="tag" href={`/tags/${tag}/`}>
                    {tag}
                    <span>{count}</span>
                  </a>
                ))}
              </div>
            </section>
          </div>
        </div>
      </article>
    </section>

    <section class="section explore-section explore-directory-section">
      <div class="section-heading">
        <h2>All apps</h2>
      </div>
      <AppDirectory apps={apps} />
    </section>

  </section>
</BaseLayout>
