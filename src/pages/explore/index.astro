---
import { getCollection } from 'astro:content';
import { OG_SIZE, ogPath } from '../../data/og';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { topLevelTrail, itemListSchema } from '../../data/breadcrumb';
import AppDirectory from '../../components/AppDirectory.astro';
import MetaIcon from '../../components/MetaIcon.astro';
import {
  categories,
  collectionLabels,
  collections
} from '../../data/categories';

/* Two things, in this order: the taxonomy, then the catalogue itself.
   The page used to run to eight screens by sampling three apps from each of eight
   shelves and closing on a carousel that surfaced one app per gesture, which meant the
   browse index never actually contained the thing it indexed: every child page carried
   a count, a filter and a sort that its own parent did not. `AppDirectory` is the same
   component the tag, collection and category pages already use, so Explore now has at
   least as much power as anything below it.

   Deleting the shelves took the client renderer with them, and with it a second random
   selection that overwrote the server's on every load, and a hand-copied card template
   that had already drifted from `AppCard.astro`. */
const apps = await getCollection('apps');
const sortedCategories = [...categories].sort((a, b) =>
  a.title.localeCompare(b.title, undefined, { sensitivity: 'base' })
);

/* An app carries several categories, so these do not partition the catalogue and will
   not sum to its size. They answer "how much is behind this door", which is what a
   reader picking a lane is asking, with counts derived from the same records as the directory. */
const categoryCounts = new Map(
  categories.map((category) => [
    category.slug,
    apps.filter((entry) => entry.data.categories.includes(category.slug)).length
  ])
);
const collectionCounts = new Map(
  collections.map((collection) => [
    collection.slug,
    apps.filter((entry) => entry.data.collections?.includes(collection.slug)).length
  ])
);
const trail = topLevelTrail('Explore');

const listSchema = itemListSchema(apps.map((entry) => ({ name: entry.data.name, href: `/apps/${entry.id}/` })), Astro.site);
---
<BaseLayout
  structuredData={[listSchema]}
  breadcrumb={trail}
  title="Explore Mac Apps — App Waypoint"
  socialImage={ogPath('explore')}
  socialImageSize={OG_SIZE}
  socialImageAlt="Explore every Mac app App Waypoint has recommended, by category, collection or tag."
  description="Browse every Mac app App Waypoint has recommended, by category, collection or tag, with the full catalog filterable and sortable on one page."
  current="explore"
>
  <section class="page-shell archive-page explore-page">
    <Breadcrumb trail={trail} />
    <header class="explore-hero">
      <h1>Explore Apps</h1>
      <p class="dek">
        Hand-picked Mac apps from every issue, browsable by category, collection or tag.
        Apps selected and added every Friday.
      </p>
    </header>

    <div class="explore-taxonomy">
      <section aria-labelledby="explore-categories-heading">
        <h2 class="eyebrow" id="explore-categories-heading">Categories</h2>
        <ul class="explore-lanes explore-lanes-categories">
          {sortedCategories.map((category) => (
            <li><a class="app-detail-category-row explore-lane" href={`/categories/${category.slug}/`}>
              <span class="app-detail-category-mark" aria-hidden="true"><MetaIcon name={category.icon} /></span>
              <span>{category.title}</span>
              <span class="explore-lane-count">
                <span>{categoryCounts.get(category.slug)}</span>
                <span class="sr-only">{categoryCounts.get(category.slug) === 1 ? 'app' : 'apps'}</span>
              </span>
            </a></li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="explore-collections-heading">
        <h2 class="eyebrow" id="explore-collections-heading">Collections</h2>
        <ul class="explore-lanes explore-lanes-collections">
          {collections.map((collection) => (
            <li><a class="collection-badge explore-lane" href={`/collections/${collection.slug}/`}>
              <span class="app-detail-category-mark" aria-hidden="true"><MetaIcon name={collection.icon} /></span>
              <span class="collection-badge-label">{collectionLabels[collection.slug]}</span>
              <span class="explore-lane-count">
                <span>{collectionCounts.get(collection.slug)}</span>
                <span class="sr-only">{collectionCounts.get(collection.slug) === 1 ? 'app' : 'apps'}</span>
              </span>
            </a></li>
          ))}
        </ul>
      </section>
    </div>

    <section class="section explore-section explore-directory-section">
      <AppDirectory apps={apps} heading="All apps" />
    </section>

  </section>
</BaseLayout>

<style>
  /* A single grouped menu, using the detail rail's labels and Phosphor marks. It takes
     no surface of its own. An index is page structure rather than an object placed on
     the page, and a card around it made it read as the first item in the directory
     below rather than the way into it. The spacing does the separating, which is the
     same argument that took the hairlines off every other section here. */
  .explore-taxonomy {
    display: grid;
    gap: var(--space-2);
    /* One boundary, top and bottom, on the site's own section token. It was a 32px
       margin plus 32px of padding, which the card justified: the margin held the card
       off the hero and the padding inset the rows inside it. With no card there is no
       inside, so the two stacked into 64px above the eyebrow against 32px below the
       last row. `--section-space` also steps 24/32/40 at the site's breakpoints, where
       the two hand-rolled values did not, which is what the mobile override existed to
       patch.

       No horizontal padding. The lanes below track the card grid's own columns, which
       are measured against the full shell width, so insetting this box would shift
       every column off the cards it is meant to line up with. The breathing room comes
       from the lane padding instead, which is the card's own inset. */
    padding: var(--section-space) 0;
  }
  /* The eyebrow starts where a lane's mark starts, not at the panel edge. */
  .explore-taxonomy .eyebrow {
    margin: 0 0 var(--space-1);
    padding-inline: var(--space-3);
  }
  /* Three columns on the card grid's own geometry. `.grid` is twelve tracks with a
     16px column gap and each card spans four, which puts the card edges at exactly the
     same places three equal columns with a 16px gap do, provided both are measured
     across the full shell width. The gap is the load-bearing part: at 24px the columns
     drifted +32, +13 and -5px against the three cards below them. */
  .explore-lanes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1) 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .explore-lanes-categories {
    grid-auto-flow: column;
    grid-template-rows: repeat(3, minmax(32px, auto));
  }
  .explore-lanes li { min-width: 0; }
  .explore-lane {
    grid-template-columns: 32px minmax(0, 1fr) auto;
    /* The app card's own inset, so a lane's mark and label start on the same vertical
       as the icon and title of the card beneath it. */
    padding-inline: var(--space-3);
    min-height: 32px;
    height: 100%;
    column-gap: var(--space-1);
    font-family: var(--sans);
  }
  /* Hover is the accent on the label and nothing else, inherited from the app detail
     rail's own rows. This is a named exception to the panel-row fill in DESIGN.md,
     decided by the editor on 2026-09-11: the menu is a quiet index at the top of the
     page, and a fill under every row the pointer crosses made it the loudest object on
     a surface whose job is to be scanned. The ring below still needs a corner. */
  .explore-lane:focus-visible { border-radius: var(--radius-sm); }
  /* Inset, so the ring sits inside the row rather than crossing the row 8px below it.
     The rail's +3px offset is correct in a rail and wrong in a dense panel; the
     directory's select options already take -2px for exactly this reason. */
  .explore-lane:focus-visible { outline-offset: -2px; }
  /* The coarse-pointer floor reaches `.collection-badge` globally, but this page's
     scoped 32px carries the Astro attribute and outranks it, so the floor silently
     stopped applying to the rows that quote it. Restated here at the same specificity
     as the declaration that broke it. */
  @media (pointer: coarse) {
    .explore-lane { min-height: 48px; }
  }
  .explore-lane-count {
    padding-left: var(--space-1);
    color: var(--muted);
    font-size: var(--type-meta);
    line-height: var(--leading-meta);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Collapse where the cards collapse. `.grid > *` goes from span 4 to span 12 at 920
     with no two-column step in between, so a two-column taxonomy over a three-column
     card grid would be misaligned by construction at exactly the widths this is meant
     to line up at. */
  @media (max-width: 920px) {
    .explore-lanes {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }
</style>
