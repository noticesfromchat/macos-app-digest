---
import { getCollection } from 'astro:content';
import { OG_SIZE, ogPath } from '../../data/og';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { topLevelTrail, itemListSchema } from '../../data/breadcrumb';
import AppDirectory from '../../components/AppDirectory.astro';
import MetaIcon from '../../components/MetaIcon.astro';
import {
  categories,
  collectionLabels,
  collections
} from '../../data/categories';

/* Two things, in this order: the taxonomy, then the catalogue itself.
   The page used to run to eight screens by sampling three apps from each of eight
   shelves and closing on a carousel that surfaced one app per gesture, which meant the
   browse index never actually contained the thing it indexed: every child page carried
   a count, a filter and a sort that its own parent did not. `AppDirectory` is the same
   component the tag, collection and category pages already use, so Explore now has at
   least as much power as anything below it.

   Deleting the shelves took the client renderer with them, and with it a second random
   selection that overwrote the server's on every load, and a hand-copied card template
   that had already drifted from `AppCard.astro`. */
const apps = await getCollection('apps');
const sortedCategories = [...categories].sort((a, b) =>
  a.title.localeCompare(b.title, undefined, { sensitivity: 'base' })
);

/* An app carries several categories, so these do not partition the catalogue and will
   not sum to its size. They answer "how much is behind this door", which is what a
   reader picking a lane is asking, with counts derived from the same records as the directory. */
const categoryCounts = new Map(
  categories.map((category) => [
    category.slug,
    apps.filter((entry) => entry.data.categories.includes(category.slug)).length
  ])
);
const collectionCounts = new Map(
  collections.map((collection) => [
    collection.slug,
    apps.filter((entry) => entry.data.collections?.includes(collection.slug)).length
  ])
);
const trail = topLevelTrail('Explore');

const listSchema = itemListSchema(apps.map((entry) => ({ name: entry.data.name, href: `/apps/${entry.id}/` })), Astro.site);
---
<BaseLayout
  structuredData={[listSchema]}
  breadcrumb={trail}
  title="Explore Mac Apps — App Waypoint"
  socialImage={ogPath('explore')}
  socialImageSize={OG_SIZE}
  socialImageAlt="Explore every Mac app App Waypoint has recommended, by category, collection or tag."
  description="Browse every Mac app App Waypoint has recommended, by category, collection or tag, with the full catalog filterable and sortable on one page."
  current="explore"
>
  <section class="page-shell archive-page explore-page">
    <Breadcrumb trail={trail} />
    <header class="explore-hero">
      <h1>Explore Apps</h1>
      <p class="dek">
        Hand-picked Mac apps from every issue, browsable by category, collection or tag.
        Apps selected and added every Friday.
      </p>
    </header>

    <div class="explore-taxonomy">
      <section aria-labelledby="explore-categories-heading">
        <h2 class="eyebrow" id="explore-categories-heading">Categories</h2>
        <div class="explore-lanes explore-lanes-categories">
          {sortedCategories.map((category) => (
            <a class="explore-lane explore-lane-category" href={`/categories/${category.slug}/`}>
              <span class="explore-lane-icon" aria-hidden="true"><MetaIcon name={category.icon} /></span>
              <strong>{category.title}</strong>
              <span class="explore-lane-count">
                <span>{categoryCounts.get(category.slug)}</span>
                <span class="eyebrow">{categoryCounts.get(category.slug) === 1 ? 'app' : 'apps'}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="explore-collections-heading">
        <h2 class="eyebrow" id="explore-collections-heading">Collections</h2>
        <div class="explore-lanes explore-lanes-collections" style={`--collection-count: ${collections.length}`}>
          {collections.map((collection) => (
            <a class="explore-lane explore-lane-collection" href={`/collections/${collection.slug}/`}>
              <span class="explore-lane-icon" aria-hidden="true"><MetaIcon name={collection.icon} /></span>
              <strong>{collectionLabels[collection.slug]}</strong>
              <span class="explore-lane-count">
                <span>{collectionCounts.get(collection.slug)}</span>
                <span class="eyebrow">{collectionCounts.get(collection.slug) === 1 ? 'app' : 'apps'}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <section class="section explore-section explore-directory-section">
      <AppDirectory apps={apps} heading="All apps" />
    </section>

  </section>
</BaseLayout>

<style>
  .explore-taxonomy {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
  }
  .explore-lanes {
    display: grid;
    gap: var(--space-2);
  }
  .explore-lanes-categories { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .explore-lanes-collections { grid-template-columns: repeat(var(--collection-count), minmax(0, 1fr)); }
  .explore-lane {
    display: grid;
    min-width: 0;
    gap: var(--space-2);
    padding: var(--space-3);
    /* The card rest state. No border: the fill and the resting shadow separate a card
       from the page, and the ring layer is carried transparent so the hover cross
       interpolates one layer against one rather than none against one. Inset and
       radius are both 24px, the app card's, so a tile is a card at tile size. */
    border: 0;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px transparent, var(--shadow);
    color: var(--text);
    text-decoration: none;
  }
  .explore-lane-category { grid-template-rows: auto 1fr auto; }
  .explore-lane-icon {
    display: flex;
    align-items: center;
    min-height: var(--space-4);
  }
  .explore-lane-icon :global(svg) { --icon-size: var(--icon-md); }
  .explore-lane strong {
    font-family: var(--display);
    font-size: var(--type-tile-title);
    font-weight: 600;
    line-height: var(--leading-tile-title);
    overflow-wrap: anywhere;
  }
  .explore-lane-count {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    white-space: nowrap;
    font-family: var(--display);
    /* The count sits at the title's own size and separates on weight instead: 400
       against the name's 600. It was the subhead clamp, so a number inside a fixed
       180px tile scaled with the viewport and reached 28px, outranking the name it
       qualifies. Taxonomy does not outrank identity, and the category name is the
       identity here while the count is metadata about it. */
    font-size: var(--type-tile-title);
    line-height: var(--leading-tile-title);
    font-variant-numeric: tabular-nums;
  }
  .explore-lane-count .eyebrow { margin: 0; font-family: var(--sans); color: var(--muted); }
  .explore-lane-collection {
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    min-height: calc(var(--space-5) * 2);
  }
  /* The One Hover Rule, the same contract every card that leads somewhere is on:
     rest at Ambient Card, cross to Hover Lift and an accent ring over 320ms, and only
     where a pointer can actually hover, so a touch device is not left in a stuck
     hover state. The label and mark taking the accent is this surface's own addition
     on top of the contract, kept because a ring alone is quiet at tile size. */
  @media (hover: hover) and (pointer: fine) {
    .explore-lane {
      transition:
        box-shadow 320ms cubic-bezier(.16, 1, .3, 1),
        color 320ms cubic-bezier(.16, 1, .3, 1);
    }
    .explore-lane:hover {
      box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--accent) 42%, var(--line)),
        var(--shadow-hover);
    }
    .explore-lane:hover strong,
    .explore-lane:hover .explore-lane-icon { color: var(--accent); }
  }
  /* The border used to carry focus. With it gone, focus takes the house ring. */
  .explore-lane:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .explore-lane:focus-visible strong,
  .explore-lane:focus-visible .explore-lane-icon { color: var(--accent); }
  @media (max-width: 1100px) {
    .explore-lanes-categories { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* The band where three collection tiles share a shrinking shell: 332px each at 1100
     and 277px at 921. A count sitting beside the title takes width the name needs, and
     "Community Favorites" was breaking mid-word — "Commu / nity" — to fit what was left.
     The count moves under the title here so the name has the tile's full measure. Above
     1100 the tile is 376px and does not need it; below 921 the row is one column and has
     the whole shell. */
  @media (min-width: 921px) and (max-width: 1100px) {
    .explore-lane-collection { grid-template-columns: auto minmax(0, 1fr); }
    .explore-lane-collection .explore-lane-count { grid-column: 2; }
  }
  /* Collections collapse with the app grid rather than 240px later. They held three
     columns down to 680 while the cards beneath had already gone to one, which is what
     made the row read as broken rather than merely tight. */
  @media (max-width: 920px) {
    .explore-lanes-collections { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .explore-taxonomy { padding-top: var(--space-3); }
    .explore-lanes-categories { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 360px) {
    .explore-lanes-categories { grid-template-columns: 1fr; }
    .explore-lane-collection { grid-template-columns: auto minmax(0, 1fr); }
    .explore-lane-collection .explore-lane-count { grid-column: 2; }
  }
</style>
