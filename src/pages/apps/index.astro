---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppDirectory from '../../components/AppDirectory.astro';

const apps = await getCollection('apps');
---
<BaseLayout
  title="All Mac Apps — App Waypoint"
  description="Browse every Mac app in the App Waypoint catalog, with filters, sorting and direct links to individual app pages."
>
  <section class="page-shell archive-page">
    <h1>Browse All Apps</h1>
    <p class="dek">A complete list of App Waypoint's Mac app catalog.</p>
    <AppDirectory apps={apps} />
  </section>
</BaseLayout>
