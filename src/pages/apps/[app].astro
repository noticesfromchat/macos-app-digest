---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ArrowUpRight } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCard from '../../components/AppCard.astro';
import MetaIcon from '../../components/MetaIcon.astro';
import {
  categories,
  collectionLabels,
  collections as collectionMeta
} from '../../data/categories';

type AppEntry = CollectionEntry<'apps'>;

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { app: app.id },
    props: { app, apps }
  }));
}

const { app, apps } = Astro.props as {
  app: AppEntry;
  apps: AppEntry[];
};

const appCategories = categories.filter((category) =>
  app.data.categories.includes(category.slug)
);
const appCollections = collectionMeta.filter((collection) =>
  app.data.collections?.includes(collection.slug)
);

// Pool of the most category-related apps, most-related first. The client shuffles
// this pool on each load; CSS shows only the first six, so no-JS visitors still get
// the six most-related apps and there is no post-paint card swap. The pool is capped
// so a broadly-tagged app does not render dozens of hidden cards per page.
const RELATED_POOL_SIZE = 24;
const relatedApps = apps
  .map((entry) => ({
    entry,
    sharedCategoryCount: entry.data.categories.filter((category) =>
      app.data.categories.includes(category)
    ).length
  }))
  .filter(({ entry, sharedCategoryCount }) => entry.id !== app.id && sharedCategoryCount > 0)
  .sort((a, b) =>
    b.sharedCategoryCount - a.sharedCategoryCount ||
    a.entry.data.name.localeCompare(b.entry.data.name, undefined, { sensitivity: 'base' })
  )
  .map(({ entry }) => entry)
  .slice(0, RELATED_POOL_SIZE);

const appUrl = new URL(Astro.url.pathname, Astro.site).href;
const appSchema = [
  {
    '@type': 'SoftwareApplication',
    '@id': `${appUrl}#software`,
    name: app.data.name,
    description: app.data.description,
    url: app.data.homepage,
    applicationCategory: appCategories.map((category) => category.title).join(', '),
    keywords: app.data.tags.join(', '),
    operatingSystem: 'macOS',
    isPartOf: { '@id': new URL('/#website', Astro.site).href },
    mainEntityOfPage: appUrl
  }
];
---

<BaseLayout
  title={`${app.data.name} for Mac — App Waypoint`}
  description={`${app.data.description} ${app.data.bestFor}`}
  current="app"
  structuredData={appSchema}
>
  <article class="page-shell app-detail-page">
    <header class="app-detail-hero">
      <p class="eyebrow">App Detail</p>
      <h1>{app.data.name}</h1>
      <p class="dek">{app.data.description}</p>
      <div class="app-detail-meta-flow">
        {appCollections.length > 0 && (
          <div class="app-detail-collections" aria-label="Collections">
            {appCollections.map((collection) => (
              <a class="collection-badge" href={`/collections/${collection.slug}/`}>
                <span class="collection-badge-icon" aria-hidden="true">
                  <MetaIcon name={collection.icon} />
                </span>
                <span>{collectionLabels[collection.slug]}</span>
              </a>
            ))}
          </div>
        )}
        <div class="app-detail-best-for">
          <p class="eyebrow">Best For</p>
          <p>{app.data.bestFor}</p>
        </div>
      </div>
      <div class="app-detail-actions">
        <a class="button" href={app.data.homepage} target="_blank" rel="noreferrer">Homepage <ArrowUpRight aria-hidden="true" /></a>
      </div>
    </header>

    <section class="app-detail-taxonomy">
      <div class="section-heading">
        <p class="eyebrow">Categories</p>
      </div>
      <div class="app-detail-category-grid" aria-label="App categories">
        {appCategories.map((category) => (
          <a
            class="app-detail-category-card"
            href={`/categories/${category.slug}/`}
            style={`--category-accent: ${category.accent};`}
          >
            <span class="app-detail-category-icon" aria-hidden="true">
              <MetaIcon name={category.icon} />
            </span>
            <span class="app-detail-category-copy">
              <strong>{category.title}</strong>
            </span>
          </a>
        ))}
      </div>
      <div class="app-detail-tag-stack">
        <p class="eyebrow">Tags</p>
        <div class="tag-list app-detail-tags" aria-label="App tags">
          {app.data.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}
        </div>
      </div>
    </section>

    {relatedApps.length > 0 && (
      <section class="section app-detail-section">
        <div class="section-heading">
          <p class="eyebrow">You May Also Like</p>
          <h2>More apps like this</h2>
        </div>
        <div class="grid directory-grid app-detail-related-grid" data-related-apps-grid>
          {relatedApps.map((entry) => <AppCard app={entry.data} appId={entry.id} />)}
        </div>
      </section>
    )}
  </article>
  {relatedApps.length > 0 && (
    <script is:inline>
      (() => {
        const grid = document.querySelector('[data-related-apps-grid]');
        if (!grid) return;
        const cards = Array.from(grid.children);
        for (let i = cards.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [cards[i], cards[j]] = [cards[j], cards[i]];
        }
        const fragment = document.createDocumentFragment();
        cards.forEach((card) => fragment.appendChild(card));
        grid.appendChild(fragment);
      })();
    </script>
  )}
</BaseLayout>
