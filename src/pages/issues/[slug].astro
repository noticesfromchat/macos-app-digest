---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssuePage from '../../components/IssuePage.astro';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  const apps = await getCollection('apps');
  return issues.map((issue) => ({
    params: { slug: issue.data.slug },
    props: { issue, apps }
  }));
}

const { issue, apps } = Astro.props;
---
<BaseLayout
  title={`${issue.data.rss.title} — Mac Apps Issue ${issue.data.number} — App Waypoint`}
  description={issue.data.dek}
  current="issue"
  type="article"
  publishedTime={issue.data.slug}
  socialImageAlt={`App Waypoint's Mac app digest for ${issue.data.date}.`}
>
  <IssuePage issue={issue.data} appEntries={apps} />
</BaseLayout>
