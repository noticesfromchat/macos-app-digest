---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { topLevelTrail } from '../data/breadcrumb';
import { OG_SIZE, ogPath } from '../data/og';
import RichText from '../components/RichText.astro';
import { richLines, richParagraphs } from '../data/rich-text';
import { siteCopy, type SiteCopyKey } from '../data/site-copy';

const trail = topLevelTrail('About');

/* The page closes on a route to the newest issue, which is the one thing a reader
   convinced by this page would want next. Resolved at build time the same way the
   homepage resolves it, so the link cannot go stale on a Friday. */
const issues = await getCollection('issues');
const latestIssue = [...issues].sort((a, b) => b.data.slug.localeCompare(a.data.slug))[0];

/* Each section is a heading and its prose from src/data/site-copy.ts, where the editor's
   Misc tab writes them. The order and the shape of the page stay here. */
const sections: { heading: SiteCopyKey; lead?: SiteCopyKey; list?: SiteCopyKey; prose?: SiteCopyKey; cta?: boolean }[] = [
  { heading: 'about.criteriaHeading', lead: 'about.criteriaIntro', list: 'about.criteria' },
  { heading: 'about.sourcesHeading', prose: 'about.sources' },
  { heading: 'about.aiHeading', prose: 'about.ai' },
  { heading: 'about.supportHeading', prose: 'about.support', cta: true }
];
---
<BaseLayout
  breadcrumb={trail}
  title="About — App Waypoint"
  description={siteCopy['about.metaDescription']}
  current="about"
  socialImage={ogPath('about')}
  socialImageSize={OG_SIZE}
  socialImageAlt={siteCopy['about.socialAlt']}
>
  <article class="page-shell archive-page about-page">
    <Breadcrumb trail={trail} />
    <h1>About</h1>
    {/* The dek, under The One Page Title Rule, which every page obeys. What changed is
        what fills it: a summary line written in a marketing register the rest of the page
        had already dropped, replaced by the sentence the page actually opens on. The
        introduction follows the enthusiasm rather than preceding it. */}
    <p class="dek"><RichText text={siteCopy['about.dek']} /></p>

    <div class="about-content">
      {richParagraphs(siteCopy['about.intro']).map((paragraph) => <p><RichText segments={paragraph.segments} /></p>)}
    </div>

    {/* The policy line under "What do I get" states only what the editor confirmed: nobody
        pays, and a promoted app would be marked. The thanks and the route out close that
        section rather than forming their own, because a section of their own drew a rule
        across the page for what is the same thought finishing. */}
    {sections.map((section) => (
      <section class="section">
        <div class="section-heading">
          <h2 class="section-title">{siteCopy[section.heading]}</h2>
        </div>
        {section.lead && <p><RichText text={siteCopy[section.lead]} /></p>}
        {section.list && (
          <ul class="about-criteria">
            {richLines(siteCopy[section.list]).map((segments) => <li><RichText segments={segments} /></li>)}
          </ul>
        )}
        {section.prose && richParagraphs(siteCopy[section.prose]).map((paragraph) => (
          <p class={paragraph.emphasis ? 'about-emphasis' : undefined}><RichText segments={paragraph.segments} /></p>
        ))}
        {section.cta && (
          <p class="about-cta"><a class="button" href={`/issues/${latestIssue.data.slug}/`}>{siteCopy['about.ctaLabel']}</a></p>
        )}
      </section>
    ))}
  </article>
</BaseLayout>
