---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { topLevelTrail } from '../data/breadcrumb';

const trail = topLevelTrail('About');
---
<BaseLayout
  breadcrumb={trail}
  title="About — App Waypoint"
  description="Learn how App Waypoint researches and selects high-quality Mac apps for experienced users each week."
  current="about"
>
  <article class="page-shell archive-page about-page">
    <Breadcrumb trail={trail} />
    <h1>About</h1>
    <p class="dek">App Waypoint is a weekly editorial publication for experienced Mac users. Every Friday, it highlights Mac apps, productivity tools, automation utilities, AI software and worthwhile articles and videos.</p>

    <div class="about-content">
      <p>App Waypoint identifies software that earns attention through genuine usefulness, thoughtful execution and a distinctive approach to solving real problems.</p>
    </div>

    <section class="section">
      <div class="section-heading">
        <h2>How Apps Are Selected</h2>
      </div>
      <p>Apps are considered through developer releases, community discussions/buzz, independent publications, podcasts, videos and official product information.</p>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>The Editorial Process</h2>
      </div>
      <p>App Waypoint is human-curated and assisted by AI. AI helps organize research, compare candidates, verify structured information and prepare the publication. Final selections, editorial emphasis and recommendations remain human-led.</p>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Editor's Picks</h2>
      </div>
      <p>Editor's Picks are chosen exclusively by the editor and are never selected automatically.</p>
    </section>
  </article>
</BaseLayout>
