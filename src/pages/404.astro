---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhosphorIcon from '../components/PhosphorIcon.astro';
import { ogPath } from '../data/og';
import { siteCopy } from '../data/site-copy';

/* Keep dead links inside the publication shell, with search first for recovery. */
---
<BaseLayout
  title="Page Not Found — App Waypoint"
  description={siteCopy['notFound.metaDescription']}
  socialImage={ogPath('not-found')}
  socialImageAlt={siteCopy['notFound.socialAlt']}
>
  <section class="page-shell archive-page not-found-page">
    {/* The diagnosis is the page title, under The One Page Title Rule: a page opens on its
        title and its dek and nothing above them. The fact used to sit in a 12px eyebrow
        above a 40px joke, with the dek restating the joke a third time, so the smallest
        type on the page carried the only thing a lost reader came to learn. */}
    <h1>Page not found</h1>
    <p class="dek">{siteCopy['notFound.dek']}</p>

    <article
      class="not-found-routes card explore-utility-card explore-utility-combined-card explore-discovery-card"
      aria-label="Ways back into App Waypoint"
    >
      <div class="explore-discovery-layout">
        <section class="explore-discovery-categories">
          <div class="explore-collection-list explore-category-list not-found-route-grid">
            <button class="explore-discovery-link not-found-route" type="button" data-search-open>
              <span class="explore-discovery-icon" aria-hidden="true">
                <PhosphorIcon name="magnifying-glass" />
              </span>
              <span>
                <strong>{siteCopy['notFound.searchTitle']}</strong>
                <small>{siteCopy['notFound.searchBody']}</small>
              </span>
            </button>

            <a class="explore-discovery-link" href="/explore/">
              <span class="explore-discovery-icon" aria-hidden="true">
                <PhosphorIcon name="sailboat" />
              </span>
              <span>
                <strong>{siteCopy['notFound.exploreTitle']}</strong>
                <small>{siteCopy['notFound.exploreBody']}</small>
              </span>
            </a>

            <a class="explore-discovery-link" href="/issues/">
              <span class="explore-discovery-icon" aria-hidden="true">
                <PhosphorIcon name="archive" />
              </span>
              <span>
                <strong>{siteCopy['notFound.archiveTitle']}</strong>
                <small>{siteCopy['notFound.archiveBody']}</small>
              </span>
            </a>

            <a class="explore-discovery-link" href="/about/">
              <span class="explore-discovery-icon" aria-hidden="true">
                <PhosphorIcon name="lighthouse" />
              </span>
              <span>
                <strong>{siteCopy['notFound.aboutTitle']}</strong>
                <small>{siteCopy['notFound.aboutBody']}</small>
              </span>
            </a>
          </div>
        </section>
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .not-found-routes {
    width: 100%;
    margin-top: var(--space-4);
  }

  .not-found-route {
    width: 100%;
    padding-right: 0;
    padding-left: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .not-found-route:hover,
  .not-found-route:focus-visible {
    background: transparent;
  }

  @media (max-width: 680px) {
    .not-found-routes {
      margin-top: var(--space-4);
    }
  }
</style>
