---
import BaseLayout from '../layouts/BaseLayout.astro';

/* The archive is meant to be permanent, and the tag routes have been churning: five tags
   retired and redirected in the last week alone, against a hand-maintained redirect list
   in netlify.toml. Any rule that gets missed used to land a reader on the host's own grey
   error page, with no brand, no navigation and no way back. This is the same page shell
   as every other route, so a dead link stays inside the publication. */
---
<BaseLayout
  title="Page Not Found — App Waypoint"
  description="That page is not here. Browse the current issue, the archive of past issues or the App Waypoint catalog of Mac apps."
>
  <section class="page-shell archive-page">
    <h1>Nothing at this address</h1>
    <p class="dek">
      That page has moved or never existed. The issues and the app catalog are all still
      here, so try one of these.
    </p>

    <div class="not-found-routes">
      <a class="button" href="/">Current issue <span aria-hidden="true">→</span></a>
      <a class="not-found-link" href="/archive/">Past issues</a>
      <a class="not-found-link" href="/explore/">Explore apps</a>
      <button class="not-found-link" type="button" data-search-open>Search the catalog</button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-routes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 26px;
    margin-top: 30px;
  }

  /* The routes out are targets, not prose, so each clears the minimum the design system
     gives every control, and 44px on a coarse pointer. */
  .not-found-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    font-family: inherit;
    font-size: var(--type-meta);
    font-weight: 700;
    line-height: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: color 180ms ease;
  }

  .not-found-link:hover,
  .not-found-link:focus-visible {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .not-found-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 34%, transparent);
    outline-offset: 4px;
  }

  @media (pointer: coarse) {
    .not-found-link { min-height: 44px; }
  }
</style>
