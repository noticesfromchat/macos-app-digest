---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppDirectory from '../../components/AppDirectory.astro';
import NavigationCallout from '../../components/NavigationCallout.astro';

const collectionLabels: Record<string, string> = {
  'editors-picks': "Editor's Picks"
};

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  const collections = [
    ...new Set(apps.flatMap((entry) => entry.data.collections ?? []))
  ].sort();

  return collections.map((collection) => ({
    params: { collection },
    props: {
      collection,
      apps: apps.filter((entry) => entry.data.collections?.includes(collection))
    }
  }));
}

const { collection, apps } = Astro.props;
const title = collectionLabels[collection]
  ?? collection
    .split('-')
    .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
const description = collection === 'editors-picks'
  ? 'Explore Mac apps singled out by the editor for exceptional utility, thoughtful design or a distinctive approach to a familiar workflow.'
  : `Explore ${title.toLowerCase()} for experienced Mac users, with concise recommendations and links to official developer websites.`;
---
<BaseLayout
  title={`${title} Mac Apps — App Waypoint`}
  description={description}
>
  <section class="page-shell archive-page tag-page">
    <p class="eyebrow">Browse by collection</p>
    <h1>{title}</h1>
    <p class="dek">{description}</p>
    <AppDirectory
      apps={apps}
      defaultFilterType="collection"
      defaultFilterValue={collection}
    />
    <NavigationCallout />
  </section>
</BaseLayout>
