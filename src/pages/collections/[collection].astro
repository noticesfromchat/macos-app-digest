---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { laneTrail, itemListSchema } from '../../data/breadcrumb';
import AppDirectory from '../../components/AppDirectory.astro';
import { collectionLabels } from '../../data/categories';

const collectionDescriptions: Record<string, string> = {
  'editors-picks': 'Explore Mac apps singled out by the editor for exceptional utility, thoughtful design or a distinctive approach to a familiar workflow.',
  'community-favorites': 'Explore Mac apps the community keeps recommending for practical workflows, dependable utility and standout execution.'
};

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  const collections = [
    ...new Set(apps.flatMap((entry) => entry.data.collections ?? []))
  ].sort();

  return collections.map((collection) => ({
    params: { collection },
    props: {
      collection,
      apps: apps.filter((entry) => entry.data.collections?.includes(collection))
    }
  }));
}

const { collection, apps } = Astro.props;
const title = collectionLabels[collection as keyof typeof collectionLabels]
  ?? collection
    .split('-')
    .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
const description = collectionDescriptions[collection]
  ?? `Explore ${title.toLowerCase()} for experienced Mac users, with concise recommendations and links to official developer websites.`;

const trail = laneTrail(title);

const listSchema = itemListSchema(apps.map((entry) => ({ name: entry.data.name, href: `/apps/${entry.id}/` })), Astro.site);
---
<BaseLayout
  structuredData={[listSchema]}
  breadcrumb={trail}
  title={`${title} Mac Apps — App Waypoint`}
  description={description}
>
  <section class="page-shell archive-page tag-page">
    <Breadcrumb trail={trail} />
    <h1>{title}</h1>
    <p class="dek">{description}</p>
    <AppDirectory
      apps={apps}
      defaultFilterType="collection"
      defaultFilterValue={collection}
    />
  </section>
</BaseLayout>
