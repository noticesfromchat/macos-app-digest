---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { laneTrail, itemListSchema } from '../../data/breadcrumb';
import AppDirectory from '../../components/AppDirectory.astro';
import { collectionDek, collectionTitle } from '../../data/lanes';
import { OG_SIZE, collectionOgSlug, ogPath } from '../../data/og';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  const collections = [
    ...new Set(apps.flatMap((entry) => entry.data.collections ?? []))
  ].sort();

  return collections.map((collection) => ({
    params: { collection },
    props: {
      collection,
      apps: apps.filter((entry) => entry.data.collections?.includes(collection))
    }
  }));
}

const { collection, apps } = Astro.props;
const title = collectionTitle(collection);
const description = collectionDek(collection);

const trail = laneTrail(title);

const listSchema = itemListSchema(apps.map((entry) => ({ name: entry.data.name, href: `/apps/${entry.id}/` })), Astro.site);
---
<BaseLayout
  structuredData={[listSchema]}
  breadcrumb={trail}
  title={`${title} Mac Apps — App Waypoint`}
  socialImage={ogPath(collectionOgSlug(collection))}
  socialImageSize={OG_SIZE}
  socialImageAlt={`${title} on App Waypoint. ${description}`}
  description={description}
>
  <section class="page-shell archive-page tag-page">
    <Breadcrumb trail={trail} />
    <h1>{title}</h1>
    <p class="dek">{description}</p>
    <AppDirectory
      apps={apps}
      defaultFilterType="collection"
      defaultFilterValue={collection}
    />
  </section>
</BaseLayout>
