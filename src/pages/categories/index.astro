---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories';
import NavigationCallout from '../../components/NavigationCallout.astro';

const apps = await getCollection('apps');

const categoryCounts = new Map(
  categories.map((category) => [
    category.slug,
    apps.filter((entry) => entry.data.tags.some((tag) => category.tags.includes(tag))).length
  ])
);
---
<BaseLayout
  title="Categories — App Waypoint"
  description="Browse App Waypoint's category pages, each grouping related tags into a focused landing page for Mac apps."
>
  <section class="page-shell archive-page">
    <p class="eyebrow">Browse by category</p>
    <h1>Categories</h1>
    <p class="dek">Grouped landing pages for related App Waypoint tags and the apps that span them.</p>

    <div class="archive-list">
      {categories.map((category) => (
        <a class="archive-card category-card" href={`/categories/${category.slug}/`}>
          <span>{category.title}</span>
          <strong>{categoryCounts.get(category.slug) ?? 0} apps</strong>
          <em>{category.description}</em>
        </a>
      ))}
    </div>

    <NavigationCallout />
  </section>
</BaseLayout>

