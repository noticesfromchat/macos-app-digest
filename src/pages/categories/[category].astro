---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppDirectory from '../../components/AppDirectory.astro';
import NavigationCallout from '../../components/NavigationCallout.astro';
import { categories, getCategoryBySlug } from '../../data/categories';

export async function getStaticPaths() {
  const apps = await getCollection('apps');

  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      apps: apps.filter((entry) => entry.data.tags.some((tag) => category.tags.includes(tag)))
    }
  }));
}

const { category, apps } = Astro.props as {
  category: (typeof categories)[number];
  apps: CollectionEntry<'apps'>[];
};

const resolvedCategory = getCategoryBySlug(category.slug) ?? category;
const tagLinks = resolvedCategory.tags.map((tag) => `/tags/${tag}/`);
---
<BaseLayout
  title={`${resolvedCategory.title} Mac Apps — App Waypoint`}
  description={resolvedCategory.description}
>
  <section class="page-shell archive-page tag-page">
    <p class="eyebrow">Browse by category</p>
    <h1>{resolvedCategory.title}</h1>
    <p class="dek">{resolvedCategory.description}</p>
    <section class="app-detail-panel category-tags-panel">
      <div>
        <p class="eyebrow">Tags</p>
        <div class="tag-list app-detail-tags" aria-label={`${resolvedCategory.title} tags`}>
          {resolvedCategory.tags.map((tag, index) => (
            <a class="tag" href={tagLinks[index]}>{tag}</a>
          ))}
        </div>
      </div>
    </section>
    <AppDirectory apps={apps} showFilterMenu={false} />
    <NavigationCallout />
  </section>
</BaseLayout>
