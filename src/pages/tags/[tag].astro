---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppDirectory from '../../components/AppDirectory.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  const tags = [...new Set(apps.flatMap((entry) => entry.data.tags))].sort();

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      apps: apps.filter((entry) => entry.data.tags.includes(tag))
    }
  }));
}

const { tag, apps } = Astro.props;
const title = tag === 'rss'
  ? 'RSS'
  : tag.charAt(0).toUpperCase() + tag.slice(1);
const dek = tag === 'rss'
  ? 'RSS readers and tools to help with RSS feeds.'
  : `Mac apps selected for their relevance to ${title.toLowerCase()} workflows.`;
---
<BaseLayout
  title={`${title} Mac Apps — App Waypoint`}
  description={`Explore thoughtfully selected Mac apps for ${title} workflows, with concise recommendations, practical use cases and links to official developer websites.`}
>
  <section class="page-shell archive-page tag-page">
    <p class="eyebrow">Browse by tag</p>
    <h1>{title}</h1>
    <p class="dek">{dek}</p>
    <AppDirectory
      apps={apps}
      defaultFilterType="tag"
      defaultFilterValue={tag}
    />
  </section>
</BaseLayout>
