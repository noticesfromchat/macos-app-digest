---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { laneTrail, itemListSchema } from '../../data/breadcrumb';
import AppDirectory from '../../components/AppDirectory.astro';
import { tagDek, tagTagline, tagTitle } from '../../data/lanes';
import { OG_SIZE, ogPath, tagOgSlug } from '../../data/og';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  const tags = [...new Set(apps.flatMap((entry) => entry.data.tags))].sort();

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      apps: apps.filter((entry) => entry.data.tags.includes(tag))
    }
  }));
}

const { tag, apps } = Astro.props;
const title = tagTitle(tag);
const dek = tagDek(tag);

const trail = laneTrail(title);

const listSchema = itemListSchema(apps.map((entry) => ({ name: entry.data.name, href: `/apps/${entry.id}/` })), Astro.site);
---
<BaseLayout
  structuredData={[listSchema]}
  breadcrumb={trail}
  title={`${title} Mac Apps — ${tagTagline(tag)} — App Waypoint`}
  socialImage={ogPath(tagOgSlug(tag))}
  socialImageSize={OG_SIZE}
  socialImageAlt={`${title} Mac apps on App Waypoint. ${dek}`}
  description={`Explore thoughtfully selected Mac apps for ${title} workflows, with concise recommendations, practical use cases and links to official developer websites.`}
>
  <section class="page-shell archive-page tag-page">
    <Breadcrumb trail={trail} />
    <h1>{title}</h1>
    <p class="dek">{dek}</p>
    <AppDirectory
      apps={apps}
      defaultFilterType="tag"
      defaultFilterValue={tag}
    />
  </section>
</BaseLayout>
