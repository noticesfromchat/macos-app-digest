---
import { getCollection } from 'astro:content';
import { Archive, Heart, Moon, Search, Sun, X } from 'lucide-astro';
import '../styles/global.css';
import '../styles/search.css';

const {
  title = 'App Waypoint — Curated Mac Apps for Experienced Users',
  description = 'App Waypoint is a human-curated weekly guide to exceptional Mac apps, productivity tools, automation utilities, AI software and worthwhile reading.',
  current = '',
  type = 'website',
  publishedTime,
  socialImage = '/harbor-hero-clean.webp',
  socialImageAlt = 'App Waypoint, a weekly guide to curated Mac apps for experienced users.'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage, Astro.site);
const searchApps = (await getCollection('apps'))
  .map((entry) => ({
    id: entry.id,
    name: entry.data.name,
    description: entry.data.description,
    bestFor: entry.data.bestFor,
    tags: entry.data.tags,
    source: entry.data.source,
    homepage: entry.data.homepage,
    url: `/apps/${entry.id}/`
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
const graph = [
  {
    '@type': 'Organization',
    '@id': new URL('/#publisher', Astro.site).href,
    name: 'App Waypoint',
    url: new URL('/', Astro.site).href,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/app-waypoint-logo.png', Astro.site).href
    }
  },
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).href,
    name: 'App Waypoint',
    url: new URL('/', Astro.site).href,
    description: 'App Waypoint is a human-curated weekly guide to exceptional Mac apps, productivity tools, automation utilities, AI software and worthwhile reading.',
    publisher: { '@id': new URL('/#publisher', Astro.site).href }
  },
  type === 'article'
    ? {
        '@type': 'BlogPosting',
        '@id': `${canonical.href}#article`,
        headline: title,
        description,
        datePublished: publishedTime,
        mainEntityOfPage: canonical.href,
        author: { '@type': 'Organization', name: 'App Waypoint' },
        publisher: { '@id': new URL('/#publisher', Astro.site).href },
        image: socialImageUrl.href
      }
    : {
        '@type': 'WebPage',
        '@id': `${canonical.href}#webpage`,
        name: title,
        description,
        url: canonical.href,
        isPartOf: { '@id': new URL('/#website', Astro.site).href }
      }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#eee5d3" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="App Waypoint" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/app-waypoint-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/app-waypoint-logo.png" />
    <link rel="preload" href="/fonts/Seamless.otf" as="font" type="font/otf" crossorigin="anonymous" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('app-waypoint-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <header class:list={['site-header', { 'hero-aware': current === 'issue', 'hide-mobile-nav': current !== 'issue' }]}>
      <a class="brand" href="/" aria-label="App Waypoint home">
        <span class="brand-icon" aria-hidden="true">
          <img src="/app-waypoint-logo.png" alt="" />
        </span>
        <span class="brand-name">App Waypoint</span>
      </a>
      <nav aria-label="Primary navigation">
        <button class="nav-search-toggle" type="button" aria-label="Search apps" data-search-open>
          <Search aria-hidden="true" />
        </button>
        <span class="nav-links">
          <a class="nav-icon-link" href="/archive/" aria-label="Past issues" aria-current={current === 'archive' ? 'page' : undefined}>
            <Archive aria-hidden="true" />
          </a>
        </span>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
          <Moon data-theme-moon aria-hidden="true" />
          <Sun data-theme-sun aria-hidden="true" hidden />
        </button>
      </nav>
    </header>
    <div class="search-overlay" data-search-overlay hidden>
      <button class="search-backdrop" type="button" aria-label="Close search" data-search-close></button>
      <section
        class="search-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="search-title"
      >
        <div class="search-input-wrap">
          <Search class="search-input-icon" aria-hidden="true" />
          <label class="sr-only" id="search-title" for="site-search-input">Search apps</label>
          <input
            id="site-search-input"
            class="search-input"
            type="search"
            placeholder="Search"
            autocomplete="off"
            spellcheck="false"
            data-search-input
          />
          <button class="search-close" type="button" aria-label="Close search" data-search-close>
            <X aria-hidden="true" />
          </button>
        </div>
        <div class="search-meta">
          <p class="search-count" data-search-count></p>
          <p class="search-link-note">Results open app detail pages</p>
        </div>
        <div class="search-results" role="listbox" aria-label="Search results" data-search-results></div>
      </section>
    </div>
    <main><slot /></main>
    <footer class="site-footer">
      <a class="footer-brand" href="/" aria-label="App Waypoint home">
        <span class="footer-logo" aria-hidden="true"><img src="/app-waypoint-logo.png" alt="" /></span>
        <strong>App Waypoint</strong>
      </a>
      <p class="footer-editorial">
        <span>A weekly waypoint for Mac apps.</span>
        <span>Human-curated, thoughtfully assisted by AI.</span>
        <span class="footer-credit-ending">Published every Friday <Heart class="footer-heart" aria-hidden="true" /></span>
      </p>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/about/">About App Waypoint</a>
        <span aria-hidden="true">·</span>
        <a href="/archive/">Issue Archive</a>
      </nav>
    </footer>
    <script id="app-search-index" type="application/json" set:html={JSON.stringify(searchApps)} />
    <script is:inline>
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      const moonIcon = document.querySelector('[data-theme-moon]');
      const sunIcon = document.querySelector('[data-theme-sun]');
      const themeColor = document.querySelector('meta[name="theme-color"]');

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem('app-waypoint-theme', theme);
        const dark = theme === 'dark';
        if (moonIcon) dark ? moonIcon.setAttribute('hidden', '') : moonIcon.removeAttribute('hidden');
        if (sunIcon) dark ? sunIcon.removeAttribute('hidden') : sunIcon.setAttribute('hidden', '');
        if (toggle) toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        if (themeColor) themeColor.setAttribute('content', dark ? '#0b1726' : '#eee5d3');
      };

      applyTheme(root.dataset.theme || 'light');
      toggle?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));

      const header = document.querySelector('.site-header');
      const hero = document.querySelector('.hero');
      let ticking = false;

      const updateMobileHeader = () => {
        if (!header || !hero) return;
        header.classList.add('hero-aware');
        const mobile = window.matchMedia('(max-width: 920px)').matches;
        const threshold = hero.offsetTop + hero.offsetHeight - header.offsetHeight;
        header.classList.toggle('hero-passed', mobile && window.scrollY >= threshold);
      };

      const requestHeaderUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateMobileHeader();
          ticking = false;
        });
      };

      updateMobileHeader();
      window.addEventListener('scroll', requestHeaderUpdate, { passive: true });
      window.addEventListener('resize', requestHeaderUpdate);
    </script>
    <script is:inline>
      (() => {
        const indexNode = document.getElementById('app-search-index');
        const overlay = document.querySelector('[data-search-overlay]');
        const openButton = document.querySelector('[data-search-open]');
        const closeButtons = document.querySelectorAll('[data-search-close]');
        const input = document.querySelector('[data-search-input]');
        const results = document.querySelector('[data-search-results]');
        const count = document.querySelector('[data-search-count]');
        if (!indexNode || !overlay || !openButton || !input || !results || !count) return;

        const apps = JSON.parse(indexNode.textContent || '[]');
        let activeIndex = 0;
        let previousFocus = null;
        let scrollPosition = 0;

        const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[char]));

        const normalize = (value) => String(value).toLowerCase().trim();
        const searchableText = (app) => normalize([
          app.name,
          app.description,
          app.bestFor,
          app.source,
          ...(app.tags || [])
        ].join(' '));

        const render = () => {
          const query = normalize(input.value);
          const matches = query
            ? apps.filter((app) => searchableText(app).includes(query))
            : apps;

          activeIndex = matches.length ? Math.min(activeIndex, matches.length - 1) : -1;
          count.textContent = query
            ? `${matches.length} matching ${matches.length === 1 ? 'app' : 'apps'}`
            : `${matches.length} apps`;

          if (!matches.length) {
            results.innerHTML = '<p class="search-empty">No matching apps found.</p>';
            return;
          }

          results.innerHTML = matches.map((app, index) => {
            return `
              <a
                class="search-result${index === activeIndex ? ' is-active' : ''}"
                href="${escapeHtml(app.url)}"
                role="option"
                aria-selected="${index === activeIndex ? 'true' : 'false'}"
                data-search-result
              >
                <span class="search-result-copy">
                  <strong>${escapeHtml(app.name)}</strong>
                  <span>${escapeHtml(app.description)}</span>
                </span>
              </a>
            `;
          }).join('');
        };

        const setActive = (nextIndex) => {
          const items = [...results.querySelectorAll('[data-search-result]')];
          if (!items.length) return;
          activeIndex = (nextIndex + items.length) % items.length;
          items.forEach((item, index) => {
            const active = index === activeIndex;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-selected', active ? 'true' : 'false');
            if (active) item.scrollIntoView({ block: 'nearest' });
          });
        };

        const isMobileSearch = () => window.matchMedia('(max-width: 680px), (pointer: coarse)').matches;

        const openSearch = ({ focusInput = true } = {}) => {
          previousFocus = document.activeElement;
          scrollPosition = window.scrollY;
          overlay.hidden = false;
          document.body.classList.add('search-is-open');
          document.body.style.top = `-${scrollPosition}px`;
          input.value = '';
          activeIndex = 0;
          render();
          if (!focusInput) return;
          try {
            input.focus({ preventScroll: true });
          } catch {
            input.focus();
          }
        };

        const closeSearch = () => {
          overlay.hidden = true;
          document.body.classList.remove('search-is-open');
          document.body.style.top = '';
          window.scrollTo(0, scrollPosition);
          previousFocus?.focus?.();
        };

        openButton.addEventListener('click', () => openSearch({ focusInput: !isMobileSearch() }));
        closeButtons.forEach((button) => button.addEventListener('click', closeSearch));
        input.addEventListener('input', () => {
          activeIndex = 0;
          render();
        });

        overlay.addEventListener('mousemove', (event) => {
          const item = event.target.closest?.('[data-search-result]');
          if (!item) return;
          const items = [...results.querySelectorAll('[data-search-result]')];
          const index = items.indexOf(item);
          if (index >= 0) setActive(index);
        });

        document.addEventListener('keydown', (event) => {
          const isShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
          if (isShortcut) {
            event.preventDefault();
            overlay.hidden ? openSearch() : closeSearch();
            return;
          }
          if (overlay.hidden) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            closeSearch();
          } else if (event.key === 'ArrowDown') {
            event.preventDefault();
            setActive(activeIndex + 1);
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            setActive(activeIndex - 1);
          } else if (event.key === 'Enter') {
            const active = results.querySelector('.search-result.is-active');
            if (active) {
              event.preventDefault();
              active.click();
            }
          }
        });
      })();
    </script>
  </body>
</html>
