---
import { Archive, Heart, Moon, Sun } from 'lucide-astro';
import '../styles/global.css';

const {
  title = 'App Waypoint — Curated Mac Apps for Experienced Users',
  description = 'App Waypoint is a human-curated weekly guide to exceptional Mac apps, productivity tools, automation utilities, AI software and worthwhile reading.',
  current = '',
  type = 'website',
  publishedTime,
  socialImage = '/harbor-hero-clean.webp',
  socialImageAlt = 'App Waypoint, a weekly guide to curated Mac apps for experienced users.'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage, Astro.site);
const graph = [
  {
    '@type': 'Organization',
    '@id': new URL('/#publisher', Astro.site).href,
    name: 'App Waypoint',
    url: new URL('/', Astro.site).href,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/app-waypoint-logo.png', Astro.site).href
    }
  },
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).href,
    name: 'App Waypoint',
    url: new URL('/', Astro.site).href,
    description: 'App Waypoint is a human-curated weekly guide to exceptional Mac apps, productivity tools, automation utilities, AI software and worthwhile reading.',
    publisher: { '@id': new URL('/#publisher', Astro.site).href }
  },
  type === 'article'
    ? {
        '@type': 'BlogPosting',
        '@id': `${canonical.href}#article`,
        headline: title,
        description,
        datePublished: publishedTime,
        mainEntityOfPage: canonical.href,
        author: { '@type': 'Organization', name: 'App Waypoint' },
        publisher: { '@id': new URL('/#publisher', Astro.site).href },
        image: socialImageUrl.href
      }
    : {
        '@type': 'WebPage',
        '@id': `${canonical.href}#webpage`,
        name: title,
        description,
        url: canonical.href,
        isPartOf: { '@id': new URL('/#website', Astro.site).href }
      }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#eee5d3" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="App Waypoint" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/app-waypoint-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/app-waypoint-logo.png" />
    <link rel="preload" href="/fonts/Seamless.otf" as="font" type="font/otf" crossorigin="anonymous" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('app-waypoint-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <header class:list={['site-header', { 'hero-aware': current === 'issue', 'hide-mobile-nav': current !== 'issue' }]}>
      <a class="brand" href="/" aria-label="App Waypoint home">
        <span class="brand-icon" aria-hidden="true">
          <img src="/app-waypoint-logo.png" alt="" />
        </span>
        <span class="brand-name">App Waypoint</span>
      </a>
      <nav aria-label="Primary navigation">
        <span class="nav-links">
          <a class="nav-icon-link" href="/archive/" aria-label="Past issues" aria-current={current === 'archive' ? 'page' : undefined}>
            <Archive aria-hidden="true" />
          </a>
        </span>
        <button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
          <Moon data-theme-moon aria-hidden="true" />
          <Sun data-theme-sun aria-hidden="true" hidden />
        </button>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand">
        <span class="footer-logo" aria-hidden="true"><img src="/app-waypoint-logo.png" alt="" /></span>
        <div>
          <strong>App Waypoint</strong>
          <p>A weekly waypoint for Mac apps.</p>
        </div>
      </div>
      <div class="footer-meta">
        <p class="footer-credit">
          <span>Human-curated, thoughtfully assisted by AI.</span>
          <span class="footer-credit-ending">Published every Friday <Heart class="footer-heart" aria-hidden="true" /></span>
        </p>
        <a class="footer-about" href="/about/">About</a>
      </div>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      const moonIcon = document.querySelector('[data-theme-moon]');
      const sunIcon = document.querySelector('[data-theme-sun]');
      const themeColor = document.querySelector('meta[name="theme-color"]');

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem('app-waypoint-theme', theme);
        const dark = theme === 'dark';
        if (moonIcon) dark ? moonIcon.setAttribute('hidden', '') : moonIcon.removeAttribute('hidden');
        if (sunIcon) dark ? sunIcon.removeAttribute('hidden') : sunIcon.setAttribute('hidden', '');
        if (toggle) toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        if (themeColor) themeColor.setAttribute('content', dark ? '#0b1726' : '#eee5d3');
      };

      applyTheme(root.dataset.theme || 'light');
      toggle?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));

      const header = document.querySelector('.site-header');
      const hero = document.querySelector('.hero');
      let ticking = false;

      const updateMobileHeader = () => {
        if (!header || !hero) return;
        header.classList.add('hero-aware');
        const mobile = window.matchMedia('(max-width: 920px)').matches;
        const threshold = hero.offsetTop + hero.offsetHeight - header.offsetHeight;
        header.classList.toggle('hero-passed', mobile && window.scrollY >= threshold);
      };

      const requestHeaderUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateMobileHeader();
          ticking = false;
        });
      };

      updateMobileHeader();
      window.addEventListener('scroll', requestHeaderUpdate, { passive: true });
      window.addEventListener('resize', requestHeaderUpdate);
    </script>
  </body>
</html>
