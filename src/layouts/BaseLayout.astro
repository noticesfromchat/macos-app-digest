---
import { Archive, Check, Compass, Copy, Info, Moon, Rss, Search, Sun, X } from 'lucide-astro';
import '../styles/global.css';
import '../styles/search.css';

const {
  title = 'App Waypoint — Curated Mac Apps for Experienced Users',
  description = 'App Waypoint is a human-curated weekly guide to exceptional Mac apps, productivity tools, automation utilities, AI software and worthwhile reading.',
  current = '',
  type = 'website',
  publishedTime,
  socialImage = '/harbor-hero-clean.webp',
  socialImageAlt = 'App Waypoint, a weekly guide to curated Mac apps for experienced users.',
  structuredData = []
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage, Astro.site);
const rssUrl = new URL('/rss.xml', Astro.site);
const searchIndexUrl = new URL('/search-index.json', Astro.site);
const graph = [
  {
    '@type': 'Organization',
    '@id': new URL('/#publisher', Astro.site).href,
    name: 'App Waypoint',
    url: new URL('/', Astro.site).href,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/app-waypoint-logo.png', Astro.site).href
    }
  },
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).href,
    name: 'App Waypoint',
    url: new URL('/', Astro.site).href,
    description: 'App Waypoint is a human-curated weekly guide to exceptional Mac apps, productivity tools, automation utilities, AI software and worthwhile reading.',
    publisher: { '@id': new URL('/#publisher', Astro.site).href }
  },
  type === 'article'
    ? {
        '@type': 'BlogPosting',
        '@id': `${canonical.href}#article`,
        headline: title,
        description,
        datePublished: publishedTime,
        mainEntityOfPage: canonical.href,
        author: { '@type': 'Organization', name: 'App Waypoint' },
        publisher: { '@id': new URL('/#publisher', Astro.site).href },
        image: socialImageUrl.href
      }
    : {
        '@type': 'WebPage',
        '@id': `${canonical.href}#webpage`,
        name: title,
        description,
        url: canonical.href,
        isPartOf: { '@id': new URL('/#website', Astro.site).href }
      },
  ...structuredData
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e7ddcd" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="App Waypoint" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <link rel="alternate" type="application/rss+xml" title="App Waypoint RSS feed" href={rssUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/app-waypoint-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/app-waypoint-logo.png" />
    <link rel="preload" href="/fonts/Seamless.otf" as="font" type="font/otf" crossorigin="anonymous" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('app-waypoint-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="App Waypoint home">
        <span class="brand-icon" aria-hidden="true">
          <img src="/app-waypoint-logo.png" alt="" />
        </span>
        <span class="brand-name">App Waypoint</span>
      </a>
      <nav aria-label="Primary navigation">
        <span class="nav-links">
          <a href="/explore/" aria-current={current === 'explore' ? 'page' : undefined}>Explore Apps</a>
          <a href="/archive/" aria-current={current === 'archive' ? 'page' : undefined}>Issues</a>
          <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
        </span>
        <button
          class="nav-search-toggle"
          type="button"
          aria-label="Search apps"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="site-search-modal"
          data-search-open
        >
          <Search aria-hidden="true" />
        </button>
        <button
          class="nav-menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="mobile-nav-modal"
          data-nav-menu-open
        >
          <span class="nav-menu-toggle-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </nav>
    </header>
    <div class="mobile-nav-overlay" data-nav-menu-overlay hidden>
      <div class="mobile-nav-backdrop" aria-hidden="true"></div>
      <section
        id="mobile-nav-modal"
        class="mobile-nav-modal"
        role="dialog"
        aria-modal="true"
        aria-label="Navigation menu"
      >
        <div class="mobile-nav-actions">
          <button class="mobile-nav-search" type="button" data-mobile-search-open>
            <Search aria-hidden="true" />
            <span>Search</span>
          </button>
          <a href="/explore/" aria-current={current === 'explore' ? 'page' : undefined}>
            <Compass aria-hidden="true" />
            <span>Explore Apps</span>
          </a>
          <a href="/archive/" aria-current={current === 'archive' ? 'page' : undefined}>
            <Archive aria-hidden="true" />
            <span>Issues</span>
          </a>
          <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>
            <Info aria-hidden="true" />
            <span>About</span>
          </a>
        </div>
      </section>
    </div>
    <div class="search-overlay" data-search-overlay data-search-index-url={searchIndexUrl.pathname} hidden>
      <div class="search-backdrop" aria-hidden="true"></div>
      <section
        id="site-search-modal"
        class="search-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="search-title"
      >
        <div class="search-input-wrap">
          <Search class="search-input-icon" aria-hidden="true" />
          <label class="sr-only" id="search-title" for="site-search-input">Search apps</label>
          <input
            id="site-search-input"
            class="search-input"
            type="search"
            placeholder="Search"
            autocomplete="off"
            spellcheck="false"
            data-search-input
          />
          <button class="search-close" type="button" aria-label="Close search" data-search-close>
            <X aria-hidden="true" />
          </button>
        </div>
        <p class="search-count" aria-live="polite" data-search-count></p>
        <div class="search-results" aria-label="Search results" data-search-results></div>
      </section>
    </div>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-utilities">
        <button
          class="footer-rss-toggle"
          type="button"
          aria-label="Open RSS subscription dialog"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="rss-feed-modal"
          data-rss-open
        >
          <Rss aria-hidden="true" />
        </button>
        <button class="theme-toggle footer-theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
          <Moon data-theme-moon aria-hidden="true" />
          <Sun data-theme-sun aria-hidden="true" hidden />
        </button>
      </div>
    </footer>
    <div class="rss-overlay" data-rss-overlay hidden>
      <button class="rss-backdrop" type="button" aria-label="Close RSS subscription dialog" data-rss-close></button>
      <section
        class="rss-modal"
        id="rss-feed-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="rss-title"
        aria-describedby="rss-description"
      >
        <div class="rss-modal-topline">
          <p class="rss-kicker">Subscribe</p>
          <button class="rss-close" type="button" aria-label="Close RSS subscription dialog" data-rss-close>
            <X aria-hidden="true" />
          </button>
        </div>
        <h2 id="rss-title">App Waypoint RSS feed</h2>
        <p id="rss-description" class="rss-description">
          We love <a href="/tags/rss/">RSS</a> too, and want to make it easy for you to subscribe. Copy the URL below and paste it into your favorite RSS reader to subscribe.
        </p>
        <div class="rss-url-card">
          <code class="rss-url-value" data-rss-url>{rssUrl.href}</code>
          <button class="rss-copy-button" type="button" aria-label="Copy RSS feed URL" data-rss-copy>
            <Copy class="rss-copy-icon" aria-hidden="true" data-rss-copy-icon />
            <Check class="rss-copy-check" aria-hidden="true" hidden data-rss-copy-check />
            <span class="sr-only" data-rss-copy-label>Copy RSS feed URL</span>
          </button>
        </div>
      </section>
    </div>
    <script is:inline>
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      const moonIcon = document.querySelector('[data-theme-moon]');
      const sunIcon = document.querySelector('[data-theme-sun]');
      const themeColor = document.querySelector('meta[name="theme-color"]');

      const applyTheme = (theme) => {
        root.dataset.theme = theme;
        localStorage.setItem('app-waypoint-theme', theme);
        const dark = theme === 'dark';
        if (moonIcon) dark ? moonIcon.setAttribute('hidden', '') : moonIcon.removeAttribute('hidden');
        if (sunIcon) dark ? sunIcon.removeAttribute('hidden') : sunIcon.setAttribute('hidden', '');
        if (toggle) toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        if (themeColor) themeColor.setAttribute('content', dark ? '#091321' : '#e7ddcd');
      };

      applyTheme(root.dataset.theme || 'light');
      toggle?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));

    </script>
    <script is:inline>
      (() => {
        const overlay = document.querySelector('[data-search-overlay]');
        const openButtons = [...document.querySelectorAll('[data-search-open]')];
        const mobileSearchButton = document.querySelector('[data-mobile-search-open]');
        const closeButtons = document.querySelectorAll('[data-search-close]');
        const input = document.querySelector('[data-search-input]');
        const results = document.querySelector('[data-search-results]');
        const count = document.querySelector('[data-search-count]');
        const modal = overlay?.querySelector('.search-modal');
        if (!overlay || !openButtons.length || !input || !results || !count) return;

        const searchIndexUrl = overlay.getAttribute('data-search-index-url') || '/search-index.json';
        let previousFocus = null;
        let apps = null;
        let appsPromise = null;
        const firstFocusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

        const focusables = () =>
          [...(modal?.querySelectorAll(firstFocusableSelector) || [])].filter((item) => !item.hasAttribute('disabled'));

        const loadApps = async () => {
          if (apps) return apps;
          if (!appsPromise) {
            appsPromise = fetch(searchIndexUrl)
              .then((response) => {
                if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
                return response.json();
              })
              .then((payload) => {
                apps = Array.isArray(payload) ? payload : [];
                return apps;
              })
              .catch((error) => {
                appsPromise = null;
                throw error;
              });
          }
          return appsPromise;
        };

        const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        }[char]));

        const normalize = (value) => String(value).toLowerCase().trim();
        const searchableText = (app) => normalize([
          app.name,
          app.description,
          app.bestFor,
          app.source,
          ...(app.tags || [])
        ].join(' '));

        const render = () => {
          const appList = apps || [];
          const query = normalize(input.value);
          const matches = query
            ? appList.filter((app) => searchableText(app).includes(query))
            : appList;

          count.textContent = query
            ? `${matches.length} matching ${matches.length === 1 ? 'app' : 'apps'}`
            : `${matches.length} apps`;

          if (!matches.length) {
            results.innerHTML = '<p class="search-empty">No matching apps found.</p>';
            return;
          }

          results.innerHTML = matches.map((app, index) => {
            return `
              <a
                class="search-result"
                href="${escapeHtml(app.url)}"
                data-search-result
              >
                <span class="search-result-copy">
                  <strong>${escapeHtml(app.name)}</strong>
                  <span>${escapeHtml(app.description)}</span>
                </span>
              </a>
            `;
          }).join('');
        };

        const openSearch = async (event) => {
          const triggeredFromMobileMenu = event?.currentTarget?.hasAttribute?.('data-mobile-search-open');
          previousFocus = triggeredFromMobileMenu
            ? document.querySelector('[data-nav-menu-open]')
            : document.activeElement;
          overlay.hidden = false;
          openButtons.forEach((button) => button.setAttribute('aria-expanded', 'true'));
          input.value = '';
          count.textContent = 'Loading apps...';
          results.innerHTML = '<p class="search-empty">Loading search index...</p>';
          try {
            await loadApps();
            render();
          } catch {
            count.textContent = 'Search unavailable';
            results.innerHTML = '<p class="search-empty">Search is temporarily unavailable.</p>';
          }
          try {
            input.focus({ preventScroll: true });
          } catch {
            input.focus();
          }
        };

        const closeSearch = () => {
          overlay.hidden = true;
          openButtons.forEach((button) => button.setAttribute('aria-expanded', 'false'));
          previousFocus?.focus?.();
        };

        openButtons.forEach((button) => button.addEventListener('click', openSearch));
        mobileSearchButton?.addEventListener('click', openSearch);
        closeButtons.forEach((button) => button.addEventListener('click', closeSearch));
        input.addEventListener('input', render);
        overlay.addEventListener('click', (event) => {
          if (event.target === overlay) closeSearch();
        });

        document.addEventListener('keydown', (event) => {
          const isShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
          if (isShortcut) {
            event.preventDefault();
            overlay.hidden ? openSearch() : closeSearch();
            return;
          }
          if (overlay.hidden) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            closeSearch();
          } else if (event.key === 'Tab') {
            const items = focusables();
            if (!items.length) return;
            const currentIndex = items.indexOf(document.activeElement);
            const nextIndex = event.shiftKey
              ? (currentIndex <= 0 ? items.length - 1 : currentIndex - 1)
              : (currentIndex === -1 || currentIndex === items.length - 1 ? 0 : currentIndex + 1);
            event.preventDefault();
            items[nextIndex]?.focus();
          }
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const overlay = document.querySelector('[data-nav-menu-overlay]');
        const openButton = document.querySelector('[data-nav-menu-open]');
        const menuLinks = [...document.querySelectorAll('.mobile-nav-actions a')];
        const searchButton = document.querySelector('[data-mobile-search-open]');
        const searchOverlay = document.querySelector('[data-search-overlay]');
        const mobileNavQuery = window.matchMedia('(max-width: 680px)');
        const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (!overlay || !openButton) return;

        const firstFocusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
        let previousFocus = null;
        let stateTimer = null;
        let menuState = 'closed';

        const focusables = () => {
          const modal = overlay.querySelector('.mobile-nav-modal');
          if (!modal) return [];
          const modalItems = [...modal.querySelectorAll(firstFocusableSelector)].filter((item) => !item.hasAttribute('disabled'));
          return [openButton, ...modalItems];
        };

        const finishClose = () => {
          clearTimeout(stateTimer);
          document.documentElement.classList.remove('mobile-nav-open');
          overlay.hidden = true;
          overlay.classList.remove('is-opening', 'is-open', 'is-closing');
          menuState = 'closed';
          stateTimer = null;
        };

        const closeMenu = ({ restoreFocus = true, animate = true } = {}) => {
          if (menuState === 'closed' || menuState === 'closing') return;
          clearTimeout(stateTimer);
          openButton.setAttribute('aria-expanded', 'false');
          openButton.setAttribute('aria-label', 'Open navigation menu');
          if (restoreFocus) previousFocus?.focus?.();
          if (!animate || reduceMotionQuery.matches) {
            finishClose();
            return;
          }
          menuState = 'closing';
          overlay.classList.remove('is-opening', 'is-open');
          overlay.classList.add('is-closing');
          stateTimer = window.setTimeout(finishClose, 220);
        };

        const openMenu = () => {
          if (menuState !== 'closed') return;
          clearTimeout(stateTimer);
          previousFocus = document.activeElement;
          overlay.hidden = false;
          overlay.classList.remove('is-open', 'is-closing');
          overlay.classList.add('is-opening');
          menuState = 'opening';
          openButton.setAttribute('aria-expanded', 'true');
          openButton.setAttribute('aria-label', 'Close navigation menu');
          document.documentElement.classList.add('mobile-nav-open');
          stateTimer = window.setTimeout(() => {
            if (menuState !== 'opening') return;
            overlay.classList.remove('is-opening');
            overlay.classList.add('is-open');
            menuState = 'open';
            stateTimer = null;
          }, 580);
          const first = focusables()[1] || focusables()[0];
          try {
            first?.focus({ preventScroll: true });
          } catch {
            first?.focus();
          }
        };

        openButton.addEventListener('click', () => menuState === 'closed' ? openMenu() : closeMenu());
        menuLinks.forEach((link) => link.addEventListener('click', () => closeMenu({ restoreFocus: false, animate: false })));
        searchButton?.addEventListener('click', () => closeMenu({ restoreFocus: false, animate: false }));

        overlay.addEventListener('click', (event) => {
          if (event.target === overlay || event.target?.classList?.contains('mobile-nav-backdrop')) closeMenu();
        });

        overlay.addEventListener('animationend', (event) => {
          if (menuState === 'closing' && event.animationName === 'mobile-nav-panel-out') {
            finishClose();
            return;
          }
          if (menuState === 'opening' && event.animationName === 'mobile-nav-item-in' && event.target === focusables().at(-1)) {
            clearTimeout(stateTimer);
            overlay.classList.remove('is-opening');
            overlay.classList.add('is-open');
            menuState = 'open';
            stateTimer = null;
          }
        });

        mobileNavQuery.addEventListener('change', (event) => {
          if (!event.matches && !overlay.hidden) closeMenu({ restoreFocus: false, animate: false });
        });

        document.addEventListener('keydown', (event) => {
          if (overlay.hidden) return;
          if (searchOverlay && !searchOverlay.hidden) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            closeMenu();
            return;
          }
          if (event.key !== 'Tab') return;
          const items = focusables();
          if (!items.length) return;
          const currentIndex = items.indexOf(document.activeElement);
          const nextIndex = event.shiftKey
            ? (currentIndex <= 0 ? items.length - 1 : currentIndex - 1)
            : (currentIndex === -1 || currentIndex === items.length - 1 ? 0 : currentIndex + 1);
          event.preventDefault();
          items[nextIndex]?.focus();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const overlay = document.querySelector('[data-rss-overlay]');
        const openButtons = [...document.querySelectorAll('[data-rss-open]')];
        const closeButtons = [...document.querySelectorAll('[data-rss-close]')];
        const copyButton = document.querySelector('[data-rss-copy]');
        const copyIcon = document.querySelector('[data-rss-copy-icon]');
        const copyCheck = document.querySelector('[data-rss-copy-check]');
        const copyLabel = document.querySelector('[data-rss-copy-label]');
        const urlNode = document.querySelector('[data-rss-url]');
        if (!overlay || !copyButton || !copyIcon || !copyCheck || !copyLabel || !urlNode) return;

        const feedUrl = urlNode.textContent?.trim() || '/rss.xml';
        const openLabel = copyLabel.textContent || 'Copy RSS feed URL';
        const firstFocusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
        let previousFocus = null;
        let resetTimer = null;

        const focusables = () => {
          const modal = overlay.querySelector('.rss-modal');
          if (!modal) return [];
          return [...modal.querySelectorAll(firstFocusableSelector)].filter((item) => !item.hasAttribute('disabled'));
        };

        const setCopyState = (copied, label) => {
          copyLabel.textContent = label;
          copyButton.setAttribute('aria-label', label);
          copyIcon.toggleAttribute('hidden', copied);
          copyCheck.toggleAttribute('hidden', !copied);
          copyButton.classList.toggle('is-copied', copied);
        };

        const openRss = () => {
          previousFocus = document.activeElement;
          overlay.hidden = false;
          openButtons.forEach((button) => button.setAttribute('aria-expanded', 'true'));
          setCopyState(false, openLabel);
          try {
            focusables()[0]?.focus({ preventScroll: true });
          } catch {
            focusables()[0]?.focus();
          }
        };

        const closeRss = () => {
          overlay.hidden = true;
          openButtons.forEach((button) => button.setAttribute('aria-expanded', 'false'));
          previousFocus?.focus?.();
          setCopyState(false, openLabel);
          clearTimeout(resetTimer);
          resetTimer = null;
        };

        const copyFeedUrl = async () => {
          let copied = false;
          try {
            await navigator.clipboard.writeText(feedUrl);
            copied = true;
          } catch {
            const input = document.createElement('textarea');
            input.value = feedUrl;
            input.setAttribute('readonly', '');
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.appendChild(input);
            input.select();
            copied = document.execCommand('copy');
            document.body.removeChild(input);
          }
          if (!copied) {
            setCopyState(false, openLabel);
            clearTimeout(resetTimer);
            resetTimer = window.setTimeout(() => setCopyState(false, openLabel), 2600);
            return;
          }
          setCopyState(true, 'Copied RSS feed URL');
          clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => setCopyState(false, openLabel), 2000);
        };

        openButtons.forEach((button) => button.addEventListener('click', openRss));
        closeButtons.forEach((button) => button.addEventListener('click', closeRss));
        copyButton.addEventListener('click', copyFeedUrl);

        overlay.addEventListener('click', (event) => {
          if (event.target === overlay) closeRss();
        });

        document.addEventListener('keydown', (event) => {
          if (overlay.hidden) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            closeRss();
            return;
          }
          if (event.key !== 'Tab') return;
          const items = focusables();
          if (!items.length) return;
          const activeIndex = items.indexOf(document.activeElement);
          if (event.shiftKey) {
            if (activeIndex <= 0) {
              event.preventDefault();
              items.at(-1)?.focus();
            }
            return;
          }
          if (activeIndex === items.length - 1) {
            event.preventDefault();
            items[0]?.focus();
          }
        });
      })();
    </script>
  </body>
</html>
