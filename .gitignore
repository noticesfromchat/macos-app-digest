node_modules/
.astro/
dist/
.DS_Store
.netlify/
.pnpm-store/

# Bytecode from the vendored SEO skill's Python scripts
__pycache__/

# Agent-runtime mirrors of the vendored Impeccable skill. The canonical copies are
# tracked under .agents/skills/ and .github/skills/; these are per-runtime duplicates
# of the same release, regenerated by reinstalling the skill, and carrying a third
# 4.8MB copy buys nothing.
.claude/skills/impeccable/
.claude/agents/
.codex/

# Machine-local Claude Code settings, including this clone's hook wiring.
.claude/settings.local.json

# Impeccable critique output. Reports belong in Notion, not in the repository.
.impeccable/critique/

# Impeccable per-session hook cache written beside the skill's scripts.
**/skills/impeccable/scripts/.impeccable/

# Generated image output. Assets the site actually ships live under src/ or public/;
# anything left here is a scratch render from an imagegen run.
output/

# Impeccable engine binaries. Platform-specific and ~12MB each; the launcher
# fetches a checksum-verified copy into ~/.impeccable on demand.
**/skills/impeccable/scripts/bin/

# The local catalogue editor. It is a tool for editing this repository, not part of the
# site: it never builds, never deploys, and binds only to 127.0.0.1. It stays in the
# working tree and out of every commit, so it cannot reach a push or a preview.
#
# Ignored rather than deleted, which means `git clean -fdx` would remove it like any
# other ignored file. Keep a copy outside the repository before running that.
scripts/app-editor.mjs
scripts/app-editor-lib.mjs
scripts/app-editor.test.mjs
scripts/taxonomy-editor-lib.mjs
scripts/taxonomy-editor.test.mjs
tools/app-editor/
